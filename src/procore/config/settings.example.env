# Copy to `.env` at the repo root and fill in. `.env` is gitignored (.gitignore:30) -
# never commit real credentials. In Fabric these come from Key Vault instead; set
# PROCORE_KEYVAULT_URL and the secret names below are looked up there automatically.

# Sandbox while building; swap to https://api.procore.com for production.
# Confirm the exact sandbox host from developers.procore.com - it differs per account.
PROCORE_BASE_URL=https://sandbox.procore.com

# From your Procore Data Connector App (client-credentials grant).
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_COMPANY_ID=

# Fabric only - when set, secrets are read from Key Vault instead of this file.
# PROCORE_KEYVAULT_URL=https://<vault-name>.vault.azure.net/
