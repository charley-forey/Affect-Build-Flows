	hierarchy 'Date Hierarchy'
		lineageTag: 39bc2028-8a62-4dad-b77c-fc55b0e47004

		level Year
			lineageTag: e038ddb5-3263-4389-96d8-7359dda8b486
			column: Year

	partition Dim_Date = calculated
		mode: import
		source =
				
				VAR StartDate = DATE(2020, 1, 1)
				VAR EndDate = DATE(2030, 12, 31)
				
				RETURN
				ADDCOLUMNS(
				    CALENDAR(StartDate, EndDate),
				    "Year",                 YEAR([Date]),
				    "Month Number",         MONTH([Date]),
				    "Month Name",           FORMAT([Date], "MMMM"),
				    "Month Short",          FORMAT([Date], "MMM"),
				    "Month Year",           FORMAT([Date], "MMM YYYY"),
				    "Quarter Number",       QUARTER([Date]),
				    "Quarter",              "Q" & QUARTER([Date]),
				    "Quarter Year",         "Q" & QUARTER([Date]) & " " & YEAR([Date]),
				    "Fiscal Quarter",       "FQ" & QUARTER([Date]),
				    "Fiscal Year",          "FY" & YEAR([Date]),
				    "Fiscal Year Number",   YEAR([Date]),
				    "Week Number",          WEEKNUM([Date]),
				    "Day of Week",          FORMAT([Date], "dddd"),
				    "Day of Week Short",    FORMAT([Date], "ddd"),
				    "Day Number",           DAY([Date]),
				    "Is Weekend",           IF(WEEKDAY([Date], 2) >= 6, TRUE(), FALSE()),
				    "Year-Month Sort",      YEAR([Date]) * 100 + MONTH([Date])
				)

	annotation PBI_Id = a7025068fdad446f91a94037cecab587

