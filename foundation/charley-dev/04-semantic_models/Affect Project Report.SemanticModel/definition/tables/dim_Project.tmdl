table dim_Project

	column ProjectKey
		dataType: string
		summarizeBy: none
		sourceColumn: ProjectKey

	column ProcoreProjectId
		dataType: string
		summarizeBy: none
		sourceColumn: ProcoreProjectId

	column SageJobNumber
		dataType: string
		summarizeBy: none
		sourceColumn: SageJobNumber

	column ProjectNumber
		dataType: string
		summarizeBy: none
		sourceColumn: ProjectNumber

	column ProjectName
		dataType: string
		summarizeBy: none
		sourceColumn: ProjectName

	column OriginCode
		dataType: string
		summarizeBy: none
		sourceColumn: OriginCode

	column OriginalContractAmount
		dataType: double
		summarizeBy: sum
		sourceColumn: OriginalContractAmount

	column RetainagePercent
		dataType: double
		summarizeBy: sum
		sourceColumn: RetainagePercent

	column ContractStart
		dataType: dateTime
		summarizeBy: none
		sourceColumn: ContractStart
		formatString: yyyy-mm-dd

	column ContractFinish
		dataType: dateTime
		summarizeBy: none
		sourceColumn: ContractFinish
		formatString: yyyy-mm-dd

	column HasPrimeContract
		dataType: boolean
		summarizeBy: none
		sourceColumn: HasPrimeContract

	column IsInCrosswalk
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsInCrosswalk

	partition dim_Project = entity
		mode: directLake
		source
			entityName: dim_project
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
