table man_Milestones

	column ProjectKey
		dataType: string
		summarizeBy: none
		sourceColumn: ProjectKey

	column ActivityKey
		dataType: string
		summarizeBy: none
		sourceColumn: ActivityKey

	column MilestoneName
		dataType: string
		summarizeBy: none
		sourceColumn: MilestoneName

	column ContractStart
		dataType: dateTime
		summarizeBy: none
		sourceColumn: ContractStart
		formatString: mm/dd/yy

	column ContractFinish
		dataType: dateTime
		summarizeBy: none
		sourceColumn: ContractFinish
		formatString: mm/dd/yy

	column BaselineStart
		dataType: dateTime
		summarizeBy: none
		sourceColumn: BaselineStart
		formatString: mm/dd/yy

	column BaselineFinish
		dataType: dateTime
		summarizeBy: none
		sourceColumn: BaselineFinish
		formatString: mm/dd/yy

	column IsSubstantialCompletion
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsSubstantialCompletion

	partition man_Milestones = entity
		mode: directLake
		source
			entityName: man_milestones
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
