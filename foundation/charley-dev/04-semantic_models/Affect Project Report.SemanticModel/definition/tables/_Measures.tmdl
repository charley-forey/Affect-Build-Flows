table _Measures

	/// Replaces FINANCIALS!C3
	measure 'Original Contract' =
			VAR EndDate = MAX ( dim_Date[Date] )
			RETURN CALCULATE ( SUMX ( VALUES ( fct_FinancialPeriod[ProjectKey] ),
			CALCULATE ( LASTNONBLANKVALUE ( dim_Date[Date], SUM ( fct_FinancialPeriod[OriginalContract] ) ) ) ),
			REMOVEFILTERS ( dim_Date ), dim_Date[Date] <= EndDate )
		formatString: "$#,0"
		displayFolder: 01 Contract & Change

	/// Replaces FINANCIALS!C4
	measure 'Current Contract' =
			VAR EndDate = MAX ( dim_Date[Date] )
			RETURN CALCULATE ( SUMX ( VALUES ( fct_FinancialPeriod[ProjectKey] ),
			CALCULATE ( LASTNONBLANKVALUE ( dim_Date[Date], SUM ( fct_FinancialPeriod[CurrentContract] ) ) ) ),
			REMOVEFILTERS ( dim_Date ), dim_Date[Date] <= EndDate )
		formatString: "$#,0"
		displayFolder: 01 Contract & Change

	/// Replaces DASHBOARD!AT11
	measure 'Contract Growth %' = DIVIDE ( [Current Contract] - [Original Contract], [Original Contract] )
		formatString: "0.0%"
		displayFolder: 01 Contract & Change

	/// Replaces FINANCIALS!C5 - was =65000+3158.46+11550+4620 typed in a value cell
	measure 'Pending Change Orders' =
			VAR EndDate = MAX ( dim_Date[Date] )
			RETURN CALCULATE ( SUMX ( VALUES ( fct_FinancialPeriod[ProjectKey] ),
			CALCULATE ( LASTNONBLANKVALUE ( dim_Date[Date], SUM ( fct_FinancialPeriod[PendingChangeOrders] ) ) ) ),
			REMOVEFILTERS ( dim_Date ), dim_Date[Date] <= EndDate )
		formatString: "$#,0"
		displayFolder: 01 Contract & Change

	/// Replaces FINANCIALS!C6 - typed by hand. Pending-status COs only: Procore keeps drafts out of Pending Changes
	measure 'Age Of Oldest Unapproved CO' = MAX ( fct_FinancialPeriod[AgeOfOldestUnapprovedCO] )
		formatString: "#,0"
		displayFolder: 01 Contract & Change

	/// Replaces derived - status Approved; Draft, Rejected, No Charge and Void are neither approved nor pending
	measure 'Approved Change Orders' = CALCULATE ( SUM ( fct_ChangeOrder[Amount] ), fct_ChangeOrder[StatusCategory] = "Approved" )
		formatString: "$#,0"
		displayFolder: 01 Contract & Change

	/// Replaces derived - draft COs, not yet submitted, so excluded from [Pending Change Orders]
	measure 'Draft Change Orders' = CALCULATE ( SUM ( fct_ChangeOrder[Amount] ), fct_ChangeOrder[StatusCategory] = "Draft" )
		formatString: "$#,0"
		displayFolder: 01 Contract & Change

	/// Replaces change-order grain; responds to status and item filters
	measure 'Change Order Amount' = SUM ( fct_ChangeOrder[Amount] )
		formatString: "$#,0"
		displayFolder: 01 Contract & Change

	/// Replaces FINANCIALS!C19:C20 - as of the last budget snapshot
	measure 'Budget' = CALCULATE ( SUM ( fct_BudgetLine[BudgetAmount] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces FINANCIALS!D19:D20 - as of the last budget snapshot
	measure 'Forecast' = CALCULATE ( SUM ( fct_BudgetLine[ForecastAmount] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces FINANCIALS!D61 - as of the last budget snapshot
	measure 'Committed' = CALCULATE ( SUM ( fct_BudgetLine[CommittedAmount] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces FINANCIALS!E19:E20 - as of the last budget snapshot
	measure 'Spent To Date' = CALCULATE ( SUM ( fct_BudgetLine[SpentToDate] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces FINANCIALS!C15 - as of the last budget snapshot
	measure 'Cost To Complete' = CALCULATE ( SUM ( fct_BudgetLine[CostToComplete] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces derived - budget less spend to date
	measure 'Budget Remaining' = [Budget] - [Spent To Date]
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces the rule written out in FINANCIALS!H18:J21 but hand-picked from a dropdown
	measure 'Budget Remaining %' = DIVIDE ( [Budget Remaining], [Budget] )
		formatString: "0.0%"
		displayFolder: 02 Budget & Cost

	/// Replaces derived - budget less forecast final cost; negative = forecast over budget
	measure 'Forecast Variance' = [Budget] - [Forecast]
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces derived
	measure 'Forecast Variance %' = DIVIDE ( [Forecast Variance], [Budget] )
		formatString: "0.0%"
		displayFolder: 02 Budget & Cost

	/// Replaces FINANCIALS!F19:F20 bands applied to spend-to-date; not a forecast or completion assessment
	measure 'Budget Status' =
			VAR V = [Budget Remaining %]
			RETURN SWITCH ( TRUE(), ISBLANK ( V ), BLANK (), V >= 0, "Spend within budget", V >= -0.05, "Spend over budget up to 5%", "Spend over budget above 5%" )
		displayFolder: 02 Budget & Cost

	/// Replaces FINANCIALS!F19:F20 bands applied to forecast final cost against budget
	measure 'Forecast Status' =
			VAR V = [Forecast Variance %]
			RETURN SWITCH ( TRUE(), ISBLANK ( V ), BLANK (), V >= 0, "Forecast within budget", V >= -0.05, "Forecast over budget up to 5%", "Forecast over budget above 5%" )
		displayFolder: 02 Budget & Cost

	/// Replaces FINANCIALS!D62
	measure 'Percent Bought Out' = DIVIDE ( [Committed], [Budget] )
		formatString: "0.0%"
		displayFolder: 02 Budget & Cost

	/// Replaces no workbook equivalent - Sage AP job cost (GL 50000-50999 on a job mapped to a Procore project), to date. AP history starts 2025-03-11. NOT added to Spent To Date (no double counting)
	measure 'AP Job Cost' =
			CALCULATE ( SUM ( fct_ApInvoice[LineTotal] ), fct_ApInvoice[IsJobCost] = TRUE (),
			NOT ISBLANK ( fct_ApInvoice[ProjectKey] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces no workbook equivalent - [AP Job Cost] minus [Spent To Date], BLANK when either is blank. AP history starts 2025-03-11, so older jobs read Procore-high for timing. AP is NOT added to Spent To Date
	measure 'AP vs Procore Spent Variance' =
			VAR AP = [AP Job Cost]
			VAR Spent = [Spent To Date]
			RETURN IF ( ISBLANK ( AP ) || ISBLANK ( Spent ), BLANK (), AP - Spent )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces no workbook equivalent - [AP Job Cost] over [Spent To Date]. AP history starts 2025-03-11; AP is NOT added to Spent To Date
	measure 'AP / Procore Spent Ratio' = DIVIDE ( [AP Job Cost], [Spent To Date] )
		formatString: "0.00"
		displayFolder: 02 Budget & Cost

	/// Replaces no workbook equivalent - AP job cost at vendors with no Procore commitment or direct cost on the project: cost Spent To Date cannot contain. AP history starts 2025-03-11; NOT added to Spent To Date
	measure 'ERP-only Vendor Cost' =
			CALCULATE ( SUM ( fct_ApInvoice[LineTotal] ), fct_ApInvoice[IsErpOnlyVendor] = TRUE (),
			NOT ISBLANK ( fct_ApInvoice[ProjectKey] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces nothing - when the last PUBLISHED run passed the DQ gate, not when gold was last built
	measure 'Last Checked Run' = MAX ( meta_PipelineRun[RunAt] )
		formatString: "yyyy-mm-dd hh:nn"
		displayFolder: 14 Pipeline liveness

	/// Replaces nothing - hours since the last PUBLISHED validated run: automatic update is off, so the model only moves when cd_50_publish_models frames a run that passed the DQ gate. A blocked gate is NOT visible here (the model keeps the last good run); the alert is the signal
	measure 'Hours Since Last Checked Run' =
			VAR Last = MAX ( meta_PipelineRun[RunAt] )
			RETURN IF ( ISBLANK ( Last ), BLANK (), DATEDIFF ( Last, UTCNOW (), HOUR ) )
		formatString: "#,0"
		displayFolder: 14 Pipeline liveness

	/// Replaces nothing - status of the last PUBLISHED validated run, as text so it survives greyscale. A blocked gate never publishes, so BLOCKED is not expected in-model; the alert is the signal
	measure 'Pipeline Status' =
			VAR Last = MAX ( meta_PipelineRun[RunAt] )
			VAR Built = [Last Refresh]
			VAR Latest = FILTER ( ALL ( meta_PipelineRun ), meta_PipelineRun[RunAt] = Last )
			VAR Blocked = COUNTROWS ( FILTER ( Latest, meta_PipelineRun[Status] <> "ok" || meta_PipelineRun[Blocking] > 0 ) )
			VAR Warnings = SUMX ( Latest, meta_PipelineRun[Failing] )
			VAR Hrs = DATEDIFF ( Last, UTCNOW (), HOUR )
			RETURN SWITCH ( TRUE (),
			ISBLANK ( Last ), "Unknown - no checked run",
			Built > Last, "Unvalidated - data built after last check",
			Blocked > 0, "BLOCKED - validation failed",
			Hrs < 0, "Unknown - check timestamp is in the future",
			Hrs > 72, "STALE - no checked run in over 72 hours",
			Hrs > 30, "Late - no checked run in over 30 hours",
			Warnings > 0, "Gold checked with warnings; source completeness unverified",
			"Gold checks passed; source completeness unverified" )
		displayFolder: 14 Pipeline liveness

	/// Replaces derived
	measure 'Blocking Violations Last Run' =
			VAR Last = MAX ( meta_PipelineRun[RunAt] )
			RETURN IF ( ISBLANK ( Last ), BLANK (), COALESCE ( CALCULATE ( SUM ( meta_PipelineRun[Blocking] ),
			meta_PipelineRun[RunAt] = Last ), 0 ) )
		formatString: "#,0"
		displayFolder: 14 Pipeline liveness

	/// Replaces no workbook equivalent - vendor spend could not be sliced by cost code
	measure 'Vendor Spend' = CALCULATE ( SUM ( bridge_VendorCostCode[Amount] ), bridge_VendorCostCode[AmountType] = "Actual" )
		formatString: "$#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces FINANCIALS!D61 - committed by vendor and cost code, which the workbook cannot slice
	measure 'Vendor Committed' = CALCULATE ( SUM ( bridge_VendorCostCode[Amount] ), bridge_VendorCostCode[AmountType] = "Committed" )
		formatString: "$#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces derived
	measure 'Cost Codes Per Vendor' = COALESCE ( DISTINCTCOUNT ( bridge_VendorCostCode[CostCodeKey] ), 0 )
		formatString: "#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces derived
	measure 'Vendors Per Cost Code' = COALESCE ( DISTINCTCOUNT ( bridge_VendorCostCode[VendorKey] ), 0 )
		formatString: "#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces D8
	measure 'Certificates On File' = COALESCE ( IF ( ISFILTERED ( dim_Project ), CALCULATE ( COUNTROWS ( fct_VendorInsurance ), TREATAS ( VALUES ( bridge_ProjectVendor[VendorKey] ), fct_VendorInsurance[VendorKey] ) ), COUNTROWS ( fct_VendorInsurance ) ), 0 )
		formatString: "#,0"
		displayFolder: 15 Insurance

	/// Replaces D8
	measure 'Vendors With Insurance' = COALESCE ( IF ( ISFILTERED ( dim_Project ), CALCULATE ( DISTINCTCOUNT ( fct_VendorInsurance[VendorKey] ), TREATAS ( VALUES ( bridge_ProjectVendor[VendorKey] ), fct_VendorInsurance[VendorKey] ) ), DISTINCTCOUNT ( fct_VendorInsurance[VendorKey] ) ), 0 )
		formatString: "#,0"
		displayFolder: 15 Insurance

	/// Replaces D8
	measure 'Expired Certificates' = COALESCE ( IF ( ISFILTERED ( dim_Project ), CALCULATE ( CALCULATE ( COUNTROWS ( fct_VendorInsurance ), fct_VendorInsurance[ExpiryStatus] = "Expired" ), TREATAS ( VALUES ( bridge_ProjectVendor[VendorKey] ), fct_VendorInsurance[VendorKey] ) ), CALCULATE ( COUNTROWS ( fct_VendorInsurance ), fct_VendorInsurance[ExpiryStatus] = "Expired" ) ), 0 )
		formatString: "#,0"
		displayFolder: 15 Insurance

	/// Replaces D8 - the renewals to chase this month
	measure 'Certificates Expiring Soon' = COALESCE ( IF ( ISFILTERED ( dim_Project ), CALCULATE ( CALCULATE ( COUNTROWS ( fct_VendorInsurance ), fct_VendorInsurance[ExpiryStatus] = "Expiring within 30 days" ), TREATAS ( VALUES ( bridge_ProjectVendor[VendorKey] ), fct_VendorInsurance[VendorKey] ) ), CALCULATE ( COUNTROWS ( fct_VendorInsurance ), fct_VendorInsurance[ExpiryStatus] = "Expiring within 30 days" ) ), 0 )
		formatString: "#,0"
		displayFolder: 15 Insurance

	/// Replaces D8 - latest certificate expiration on file
	measure 'Latest Certificate Expiration' = MAX ( fct_VendorInsurance[ExpirationDate] )
		formatString: "yyyy-mm-dd"
		displayFolder: 15 Insurance

	/// Replaces D8 - a vendor with no certificate never appears in the insurance table
	measure 'Vendors Without Insurance' =
			VAR Insured = VALUES ( fct_VendorInsurance[VendorKey] )
			RETURN COALESCE ( COUNTROWS ( EXCEPT (
			VALUES ( bridge_ProjectVendor[VendorKey] ), Insured ) ), 0 )
		formatString: "#,0"
		displayFolder: 15 Insurance

	/// Replaces no workbook equivalent - Sage holds no header retainage
	measure 'Retainage Held Owner' = CALCULATE ( SUM ( fct_Billing[RetainageHeld] ), fct_Billing[IsLatestPeriod] = TRUE (), REMOVEFILTERS ( dim_Date ), fct_Billing[BillingType] = "Owner" )
		formatString: "$#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces no workbook equivalent - latest approved subcontractor pay app per commitment
	measure 'Retainage Held Sub' = CALCULATE ( SUM ( fct_Billing[RetainageHeld] ), fct_Billing[IsLatestApprovedPeriod] = TRUE (), REMOVEFILTERS ( dim_Date ), fct_Billing[BillingType] = "Subcontractor" )
		formatString: "$#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces derived - Owner-held minus sub-held; negative = Affect holds more than it is owed
	measure 'Net Retainage Position' = [Retainage Held Owner] - [Retainage Held Sub]
		formatString: "$#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces FINANCIALS!C10, sourced from Procore instead of Sage
	measure 'Owner Billed To Date' = CALCULATE ( SUM ( fct_Billing[CompletedToDate] ), fct_Billing[IsLatestPeriod] = TRUE (), REMOVEFILTERS ( dim_Date ), fct_Billing[BillingType] = "Owner" )
		formatString: "$#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces FINANCIALS!C4, cross-check on [Current Contract]
	measure 'Owner Contract Sum' = CALCULATE ( SUM ( fct_Billing[ContractSumToDate] ), fct_Billing[IsLatestPeriod] = TRUE (), REMOVEFILTERS ( dim_Date ), fct_Billing[BillingType] = "Owner" )
		formatString: "$#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces derived - contract sum less completed, including retainage
	measure 'Balance To Finish' = CALCULATE ( SUM ( fct_Billing[BalanceToFinish] ), fct_Billing[IsLatestPeriod] = TRUE (), REMOVEFILTERS ( dim_Date ), fct_Billing[BillingType] = "Owner" )
		formatString: "$#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces derived - owner billed net of retainage (payment due, Procore); safe to sum, unlike the cumulative columns
	measure 'Billed This Period' = CALCULATE ( SUM ( fct_Billing[CurrentPaymentDue] ), fct_Billing[BillingType] = "Owner", fct_Billing[StatusLabel] <> "DRAFT" )
		formatString: "$#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces derived
	measure 'Billing Periods' = COALESCE ( COUNTROWS ( fct_Billing ), 0 )
		formatString: "#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces derived - what is sitting unissued at month end
	measure 'Draft Billings' = COALESCE ( CALCULATE ( COUNTROWS ( fct_Billing ), fct_Billing[StatusLabel] = "DRAFT" ), 0 )
		formatString: "#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces no workbook equivalent - self-performed cost was never captured
	measure 'Direct Costs' = SUM ( fct_DirectCost[GrandTotal] )
		formatString: "$#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces no workbook equivalent
	measure 'Self Performed Labour' = CALCULATE ( SUM ( fct_DirectCost[GrandTotal] ), fct_DirectCost[CostType] = "payroll" )
		formatString: "$#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces derived - cost committed but not yet approved
	measure 'Unapproved Direct Costs' = CALCULATE ( SUM ( fct_DirectCost[GrandTotal] ), fct_DirectCost[IsApproved] = FALSE () )
		formatString: "$#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces D8 - the vendor list, assembled by hand from Procore today
	measure 'Vendors On Project' = COALESCE ( DISTINCTCOUNT ( bridge_ProjectVendor[VendorKey] ), 0 )
		formatString: "#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces derived
	measure 'Vendors Missing From ERP' = COALESCE ( CALCULATE ( DISTINCTCOUNT ( bridge_ProjectVendor[VendorKey] ), bridge_ProjectVendor[IsMissingFromErp] = TRUE () ), 0 )
		formatString: "#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces FINANCIALS!C10
	measure 'Total Billed' = SUM ( fct_Invoice[Amount] )
		formatString: "$#,0"
		displayFolder: 05 Cash & AR

	/// Replaces FINANCIALS!C12 - paid on invoices SENT in the period, not cash received in it
	measure 'Total Paid' = SUM ( fct_Invoice[AmountPaid] )
		formatString: "$#,0"
		displayFolder: 05 Cash & AR

	/// Replaces no workbook equivalent - invoices fully paid in the period, by paid date
	measure 'Cash Received' =
			CALCULATE ( SUM ( fct_Invoice[AmountPaid] ), NOT ISBLANK ( fct_Invoice[PaidDate] ),
			USERELATIONSHIP ( fct_Invoice[PaidDate], dim_Date[Date] ) )
		formatString: "$#,0"
		displayFolder: 05 Cash & AR

	/// Replaces FINANCIALS!F57
	measure 'AR Outstanding' = SUM ( fct_Invoice[Balance] )
		formatString: "$#,0"
		displayFolder: 05 Cash & AR

	/// Replaces DASHBOARD!AT15 - billed to date at period end over contract; was a TEXT string
	measure 'Total Billed %' =
			DIVIDE ( CALCULATE ( SUM ( fct_Invoice[Amount] ), fct_Invoice[HasUnmatchedProject] <> TRUE (),
			FILTER ( ALL ( dim_Date ), dim_Date[Date] <= MAX ( dim_Date[Date] ) ) ),
			[Current Contract] )
		formatString: "0.0%"
		displayFolder: 05 Cash & AR

	/// Replaces replaces the hand-keyed LAST PERIOD column
	measure 'Total Billed MoM %' =
			VAR Prior = CALCULATE ( [Total Billed], DATEADD ( dim_Date[Date], -1, MONTH ) )
			RETURN DIVIDE ( [Total Billed] - Prior, Prior )
		formatString: "0.0%"
		displayFolder: 05 Cash & AR

	/// Replaces SUBMITTALS & RFI!D
	measure 'Open Submittals' = CALCULATE ( COUNTROWS ( fct_RfiSubmittal ), fct_RfiSubmittal[IsOpen] = TRUE, fct_RfiSubmittal[ItemType] = "Submittal" )
		formatString: "#,0"
		displayFolder: 06 Submittals & RFIs

	/// Replaces derived - the workbook has no equivalent
	measure 'Open Submittals Past Due' = CALCULATE ( COUNTROWS ( fct_RfiSubmittal ), fct_RfiSubmittal[IsPastDue] = TRUE, fct_RfiSubmittal[ItemType] = "Submittal" )
		formatString: "#,0"
		displayFolder: 06 Submittals & RFIs

	/// Replaces QUALITY!D39 - typed by hand
	measure 'Avg Days Open' = CALCULATE ( AVERAGE ( fct_RfiSubmittal[DaysOpen] ), fct_RfiSubmittal[IsOpen] = TRUE )
		formatString: "#,0.0"
		displayFolder: 06 Submittals & RFIs

	/// Replaces derived - drafts are not yet submitted, so excluded from Open Submittals
	measure 'Draft Submittals' = CALCULATE ( COUNTROWS ( fct_RfiSubmittal ), fct_RfiSubmittal[IsDraft] = TRUE, fct_RfiSubmittal[ItemType] = "Submittal" )
		formatString: "#,0"
		displayFolder: 06 Submittals & RFIs

	/// Replaces SCHEDULE!Table5
	measure 'Critical Milestones' =
			VAR N = COUNTROWS ( fct_Milestone )
			RETURN IF ( ISBLANK ( N ) && NOT ISBLANK ( CALCULATE ( COUNTROWS ( fct_Milestone ), REMOVEFILTERS ( dim_Date ) ) ), 0, N )
		formatString: "#,0"
		displayFolder: 07 Schedule

	/// Replaces derived
	measure 'Overdue Milestones' = CALCULATE ( COUNTROWS ( fct_Milestone ), fct_Milestone[IsOverdue] = TRUE )
		formatString: "#,0"
		displayFolder: 07 Schedule

	/// Replaces DASHBOARD!L19 (Schedule Performance) - a FRACTION, which the scorecard compared against 5/9/10 (defect #1a)
	measure 'Milestones Overdue %' = DIVIDE ( [Overdue Milestones], [Critical Milestones] )
		formatString: "0.0%"
		displayFolder: 07 Schedule

	/// Replaces derived
	measure 'Avg Milestone Progress' = AVERAGE ( fct_Milestone[PercentComplete] )
		formatString: "0.0%"
		displayFolder: 07 Schedule

	/// Replaces QUALITY!Table18 - typed by hand today
	measure 'Punchlist Items' = COALESCE ( CALCULATE ( COUNTROWS ( fct_QualityItem ), fct_QualityItem[ItemType] = "PunchItem" ), 0 )
		formatString: "#,0"
		displayFolder: 08 Quality

	/// Replaces observations and punch items still outstanding
	measure 'Open Quality Items' = COALESCE ( CALCULATE ( COUNTROWS ( fct_QualityItem ), fct_QualityItem[IsOpen] = TRUE ), 0 )
		formatString: "#,0"
		displayFolder: 08 Quality

	/// Replaces open AND past their due date
	measure 'Quality Items Past Due' = COALESCE ( CALCULATE ( COUNTROWS ( fct_QualityItem ), fct_QualityItem[IsPastDue] = TRUE ), 0 )
		formatString: "#,0"
		displayFolder: 08 Quality

	/// Replaces QUALITY!D38:E38 - hand-computed today
	measure 'Avg Days Past Due' = AVERAGEX ( FILTER ( fct_QualityItem, fct_QualityItem[IsPastDue] = TRUE ), fct_QualityItem[DaysPastDue] )
		formatString: "0.0"
		displayFolder: 08 Quality

	/// Replaces present in Procore AND Sage AND Outbuild
	measure 'Projects Fully Mapped' = COALESCE ( CALCULATE ( COUNTROWS ( dim_ProjectCrosswalk ), dim_ProjectCrosswalk[SystemCount] = 3 ), 0 )
		formatString: "#,0"
		displayFolder: 09 Source Coverage

	/// Replaces all projects in the selected coverage category, including incomplete mappings
	measure 'Projects In Coverage' = COUNTROWS ( dim_ProjectCrosswalk )
		formatString: "#,0"
		displayFolder: 09 Source Coverage

	/// Replaces these read as ZERO revenue everywhere - the most dangerous gap
	measure 'Projects Missing From Sage' = COALESCE ( CALCULATE ( COUNTROWS ( dim_ProjectCrosswalk ), dim_ProjectCrosswalk[IsInSage] = FALSE ), 0 )
		formatString: "#,0"
		displayFolder: 09 Source Coverage

	/// Replaces no milestones - Outbuild is the only milestone source that exists
	measure 'Projects Missing From Outbuild' = COALESCE ( CALCULATE ( COUNTROWS ( dim_ProjectCrosswalk ), dim_ProjectCrosswalk[IsInOutbuild] = FALSE ), 0 )
		formatString: "#,0"
		displayFolder: 09 Source Coverage

	/// Replaces share of projects present in all three systems
	measure 'Source Coverage %' = DIVIDE ( [Projects Fully Mapped], COUNTROWS ( dim_ProjectCrosswalk ) )
		formatString: "0.0%"
		displayFolder: 09 Source Coverage

	/// Replaces mostly expected - a vendor invited to bid is not a vendor who was paid
	measure 'Vendors Missing From Sage' = COALESCE ( CALCULATE ( COUNTROWS ( dim_VendorCrosswalk ), dim_VendorCrosswalk[IsInSage] = FALSE ), 0 )
		formatString: "#,0"
		displayFolder: 09 Source Coverage

	/// Replaces diagnostics - cannot join to Sage until fixed
	measure 'DQ Projects Without Crosswalk' = CALCULATE ( COUNTROWS ( dim_Project ), dim_Project[IsInCrosswalk] = FALSE, dim_Project[ProjectKey] <> "UNMATCHED" )
		formatString: "#,0"
		displayFolder: 10 Data Quality

	/// Replaces diagnostics
	measure 'DQ Cost Codes Not In Source' = CALCULATE ( COUNTROWS ( dim_CostCode ), dim_CostCode[IsInSource] = FALSE )
		formatString: "#,0"
		displayFolder: 10 Data Quality

	/// Replaces diagnostics - Excel defect #6, never flagged in the workbook
	measure 'DQ Milestones With Inverted Dates' = CALCULATE ( COUNTROWS ( fct_Milestone ), fct_Milestone[HasDateInversion] = TRUE )
		formatString: "#,0"
		displayFolder: 10 Data Quality

	/// Replaces diagnostics - unmatched AR across all projects; retains the selected month
	measure 'DQ Unmatched Invoices' = CALCULATE ( COUNTROWS ( fct_Invoice ), REMOVEFILTERS ( dim_Project ), fct_Invoice[HasUnmatchedProject] = TRUE )
		formatString: "#,0"
		displayFolder: 10 Data Quality

	/// Replaces unattributed billed amount across all projects; retains the selected month
	measure 'Unmatched Billed Amount - All Projects' = CALCULATE ( SUM ( fct_Invoice[Amount] ), REMOVEFILTERS ( dim_Project ), fct_Invoice[HasUnmatchedProject] = TRUE )
		formatString: "$#,0"
		displayFolder: 10 Data Quality

	/// Replaces nothing - rejects, unmatched AR, unmapped trades, coverage and certificate gaps in one register
	measure 'Data Gaps' = COALESCE ( COUNTROWS ( dq_DataGap ), 0 )
		formatString: "#,0"
		displayFolder: 10 Data Quality

	/// Replaces money carried by data gaps - today only unmatched AR invoices carry an amount
	measure 'Data Gap Amount' = SUM ( dq_DataGap[Amount] )
		formatString: "$#,0"
		displayFolder: 10 Data Quality

	/// Replaces no workbook equivalent - a single snapshot cannot draw a curve
	measure 'Billed Cumulative' = CALCULATE ( [Billed This Period], FILTER ( ALL ( dim_Date ), dim_Date[Date] <= MAX ( dim_Date[Date] ) ) )
		formatString: "$#,0"
		displayFolder: 05 Cash & AR

	/// Replaces the S-curve against the contract line
	measure 'Billed Cumulative % Of Contract' = DIVIDE ( [Billed Cumulative], [Current Contract] )
		formatString: "0.0%"
		displayFolder: 05 Cash & AR

	/// Replaces portfolio scope - projects with financial-period rows in the current filters
	measure 'Projects Reporting' = CALCULATE ( DISTINCTCOUNTNOBLANK ( fct_FinancialPeriod[ProjectKey] ), fct_FinancialPeriod[ProjectKey] <> "UNMATCHED" )
		formatString: "#,0"
		displayFolder: 13 Portfolio

	/// Replaces no workbook equivalent - one workbook per project cannot rank them
	measure 'Projects At Risk' = COUNTROWS ( FILTER ( dim_Project, dim_Project[ProjectKey] <> "UNMATCHED" && NOT ISBLANK ( [Project Scorecard (Measured Only)] ) && [Project Scorecard (Measured Only)] < 0.6 ) )
		formatString: "#,0"
		displayFolder: 13 Portfolio

	/// Replaces Gantt geometry - the transparent leading bar
	measure 'Milestone Offset Days' =
			VAR StartDate = SELECTEDVALUE ( fct_Milestone[CurrentStart] )
			VAR FinishDate = SELECTEDVALUE ( fct_Milestone[CurrentFinish] )
			VAR Origin = MINX ( FILTER ( ALLSELECTED ( fct_Milestone ), NOT ISBLANK ( fct_Milestone[CurrentStart] ) && NOT ISBLANK ( fct_Milestone[CurrentFinish] ) && fct_Milestone[CurrentFinish] >= fct_Milestone[CurrentStart] ), fct_Milestone[CurrentStart] )
			RETURN IF ( COUNTROWS ( fct_Milestone ) = 1 && NOT ISBLANK ( StartDate ) && NOT ISBLANK ( FinishDate ) && FinishDate >= StartDate && NOT ISBLANK ( Origin ), DATEDIFF ( Origin, StartDate, DAY ), BLANK () )
		formatString: "#,0"
		displayFolder: 07 Schedule

	/// Replaces Gantt geometry - the visible bar
	measure 'Milestone Duration Days' =
			VAR StartDate = SELECTEDVALUE ( fct_Milestone[CurrentStart] )
			VAR FinishDate = SELECTEDVALUE ( fct_Milestone[CurrentFinish] )
			RETURN IF ( COUNTROWS ( fct_Milestone ) = 1 && NOT ISBLANK ( StartDate ) && NOT ISBLANK ( FinishDate ) && FinishDate >= StartDate, DATEDIFF ( StartDate, FinishDate, DAY ), BLANK () )
		formatString: "#,0"
		displayFolder: 07 Schedule

	/// Replaces no workbook equivalent - the Excel could not say when its numbers were true
	measure 'Last Refresh' = MAX ( _Measures[_built_at] )
		formatString: "yyyy-mm-dd hh:nn"
		displayFolder: 00 Report context

	/// Replaces DASHBOARD!AU4 - the month anchor, now driven by the slicer
	measure 'Report Month Label' =
			VAR L = MIN ( dim_Date[MonthStart] )
			VAR H = MAX ( dim_Date[MonthStart] )
			RETURN IF ( NOT ISFILTERED ( dim_Date ), "All months", IF ( L = H, FORMAT ( L, "MMMM YYYY" ), FORMAT ( L, "MMMM YYYY" ) & " - " & FORMAT ( H, "MMMM YYYY" ) ) )
		displayFolder: 00 Report context

	/// Replaces no workbook equivalent - [Open Submittals] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it: the build that ran overnight into that date, so sources as of the previous night
	measure 'Open Submittals (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[OpenSubmittals] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Open Submittals Past Due] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it: the build that ran overnight into that date, so sources as of the previous night
	measure 'Open Submittals Past Due (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[SubmittalsPastDue] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Open RFIs] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it: the build that ran overnight into that date, so sources as of the previous night
	measure 'Open RFIs (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[OpenRfis] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Open Observations] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it: the build that ran overnight into that date, so sources as of the previous night
	measure 'Open Observations (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[OpenObservations] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Open Punch Items] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it: the build that ran overnight into that date, so sources as of the previous night
	measure 'Open Punch Items (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[OpenPunchItems] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [AR Outstanding] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it: the build that ran overnight into that date, so sources as of the previous night
	measure 'AR Outstanding (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[ArOutstanding] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Total Billed] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it: the build that ran overnight into that date, so sources as of the previous night
	measure 'Total Billed (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[BilledToDate] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Budget] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it: the build that ran overnight into that date, so sources as of the previous night
	measure 'Budget (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[BudgetAmount] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Spent To Date] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it: the build that ran overnight into that date, so sources as of the previous night
	measure 'Spent To Date (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[SpentToDate] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Committed] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it: the build that ran overnight into that date, so sources as of the previous night
	measure 'Committed (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[CommittedAmount] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Current Contract] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it: the build that ran overnight into that date, so sources as of the previous night
	measure 'Current Contract (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[CurrentContract] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Pending Change Orders] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it: the build that ran overnight into that date, so sources as of the previous night
	measure 'Pending Change Orders (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[PendingChangeOrders] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Approved Change Orders] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it: the build that ran overnight into that date, so sources as of the previous night
	measure 'Approved Change Orders (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[ApprovedChangeOrders] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - first saved capture. SnapshotDate is the UTC date of the DQ batch that saved it: the build that ran overnight into that date, so sources as of the previous night
	measure 'Snapshot History Starts' = CALCULATE ( MIN ( fct_DailySnapshot[SnapshotDate] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "yyyy-mm-dd"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - states where saved history begins
	measure 'Snapshot History Note' =
			VAR F = CALCULATE ( MIN ( fct_DailySnapshot[SnapshotDate] ), REMOVEFILTERS ( dim_Date ) )
			RETURN IF ( ISBLANK ( F ), "No month-end history captured yet",
			"History starts " & FORMAT ( F, "yyyy-MM-dd" ) & "; earlier months are unavailable, not zero" )
		displayFolder: 16 Month-end snapshots

	/// Replaces FINANCIALS!F56 - now from Sage AR receipts (acrpmt)
	measure 'Avg Days To Payment' = AVERAGE ( fct_Invoice[DaysToPayment] )
		formatString: "#,0.0"
		displayFolder: 11 Scorecard drivers

	/// Replaces FINANCIALS!C8 - a human judgement the workbook could already have computed
	measure 'Cash Position %' = DIVIDE ( [Total Paid] + [AR Outstanding], SUM ( fct_BudgetLine[CostToComplete] ) )
		formatString: "0.0%"
		displayFolder: 11 Scorecard drivers

	/// Replaces FINANCIALS!C7 - a genuine human judgement, stays manual
	measure 'Profitability Code' = SELECTEDVALUE ( man_Flags[ProfitabilityCode] )
		displayFolder: 11 Scorecard drivers

	/// Replaces SAFETY!E - Procore /incidents, in the registry but not yet ingested
	measure 'Recordable Incidents' =
			VAR I = SUM ( fct_SafetyMonthly[RecordableIncidents] )
			VAR H = SUM ( fct_SafetyMonthly[HoursWorked] )
			RETURN IF ( H > 0 || I > 0, COALESCE ( I, 0 ) )
		formatString: "#,0"
		displayFolder: 11 Scorecard drivers

	/// Replaces SAFETY!D - Sage payroll / ADP / Procore timecards, undecided
	measure 'Hours Worked' =
			VAR H = SUM ( fct_SafetyMonthly[HoursWorked] )
			RETURN IF ( H > 0, H )
		formatString: "#,0"
		displayFolder: 11 Scorecard drivers

	/// Replaces Procore /observations/items - was QUALITY!D, typed by hand
	measure 'Observations' = COALESCE ( CALCULATE ( COUNTROWS ( fct_QualityItem ), fct_QualityItem[ItemType] = "Observation" ), 0 )
		formatString: "#,0"
		displayFolder: 11 Scorecard drivers

	/// Replaces QUALITY!D39 - typed by hand today
	measure 'Avg Observation Days To Close' = AVERAGEX ( FILTER ( fct_QualityItem, NOT fct_QualityItem[IsOpen] ), fct_QualityItem[DaysOpen] )
		formatString: "#,0.0"
		displayFolder: 11 Scorecard drivers

	/// Replaces SCORECARD CALC!E28 - Procore /daily_log_headers derives this
	measure 'Daily Reports Missed' = SUM ( man_DailyLogCompliance[LogsMissedSameDay] )
		formatString: "#,0"
		displayFolder: 11 Scorecard drivers

	/// Replaces DASHBOARD!M16 - which returned the TEXT "0 days" (defect #1b)
	measure 'Completion Variance Days' =
			VAR Baseline = MAX ( man_Milestones[BaselineFinish] )
			VAR Forecast = MAX ( fct_Milestone[CurrentFinish] )
			RETURN IF ( ISBLANK ( Baseline ) || ISBLANK ( Forecast ), BLANK (), DATEDIFF ( Baseline, Forecast, DAY ) )
		formatString: "#,0"
		displayFolder: 11 Scorecard drivers

	/// Replaces SCORECARD CALC!C42
	measure 'Client Satisfaction' = DIVIDE ( SUM ( man_Survey[Score] ), COUNTROWS ( man_Survey ) * 5 )
		formatString: "0.0%"
		displayFolder: 11 Scorecard drivers

	/// Replaces SCORECARD CALC!E13 - FIX: driver is days to payment, not an aging balance (defect #1c)
	measure 'Score - Accounts Receivable' =
			VAR V = [Avg Days To Payment]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 1
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E7
	measure 'Score - Profitability' =
			VAR V = [Profitability Code]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 2
			&& dim_ScorecardBand[MatchValue] = V
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E10 - now computed rather than picked from a dropdown
	measure 'Score - Cash Position' =
			VAR V = [Cash Position %]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 3
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E14
	measure 'Score - Change Orders' =
			VAR V = [Age Of Oldest Unapproved CO]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 4
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E16
	measure 'Score - Safety Incidents' =
			VAR V = [Recordable Incidents]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 5
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E19 - FIX: bands are fractions, so this stops always awarding 3/3 (defect #1a)
	measure 'Score - Schedule Performance' =
			VAR V = [Milestones Overdue %]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 6
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E22 - FIX: numeric, so finishing on baseline scores 3 not 0 (defect #1b)
	measure 'Score - Completion Variance' =
			VAR V = [Completion Variance Days]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 7
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E25
	measure 'Score - Observations' =
			VAR V = [Avg Observation Days To Close]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 8
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E28
	measure 'Score - Daily Reports' =
			VAR V = [Daily Reports Missed]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 9
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!G31
	measure 'Project Scorecard' =
			IF ( [Scorecard Coverage %] > 0,
			DIVIDE (
			SUMX (
			ALL ( dim_ScorecardWeight ),
			VAR S =
			SWITCH (
			dim_ScorecardWeight[CategoryKey],
			1, [Score - Accounts Receivable],
			2, [Score - Profitability],
			3, [Score - Cash Position],
			4, [Score - Change Orders],
			5, [Score - Safety Incidents],
			6, [Score - Schedule Performance],
			7, [Score - Completion Variance],
			8, [Score - Observations],
			9, [Score - Daily Reports],
			BLANK ()
			)
			RETURN IF ( ISBLANK ( S ), 0, S * dim_ScorecardWeight[Weight] )
			),
			3
			) )
		formatString: "0.00"
		displayFolder: 12 Scorecard

	/// Replaces no equivalent - the workbook could not tell you this
	measure 'Scorecard Coverage %' =
			SUMX (
			ALL ( dim_ScorecardWeight ),
			VAR S =
			SWITCH (
			dim_ScorecardWeight[CategoryKey],
			1, [Score - Accounts Receivable],
			2, [Score - Profitability],
			3, [Score - Cash Position],
			4, [Score - Change Orders],
			5, [Score - Safety Incidents],
			6, [Score - Schedule Performance],
			7, [Score - Completion Variance],
			8, [Score - Observations],
			9, [Score - Daily Reports],
			BLANK ()
			)
			RETURN IF ( ISBLANK ( S ), 0, dim_ScorecardWeight[Weight] )
			)
		formatString: "0.0%"
		displayFolder: 12 Scorecard

	/// Replaces derived - makes partial coverage comparable
	measure 'Project Scorecard (Measured Only)' = DIVIDE ( [Project Scorecard], [Scorecard Coverage %] )
		formatString: "0.00"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E23:E31 - the per-category score, never displayed in the Excel
	measure 'Category Score' =
			VAR K = SELECTEDVALUE ( dim_ScorecardWeight[CategoryKey] )
			RETURN
			SWITCH (
			K,
			1, [Score - Accounts Receivable],
			2, [Score - Profitability],
			3, [Score - Cash Position],
			4, [Score - Change Orders],
			5, [Score - Safety Incidents],
			6, [Score - Schedule Performance],
			7, [Score - Completion Variance],
			8, [Score - Observations],
			9, [Score - Daily Reports],
			BLANK ()
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!G23:G31 - ((E*F)/3), the workbook's own normalisation
	measure 'Category Weighted' =
			VAR S = [Category Score]
			VAR W = SELECTEDVALUE ( dim_ScorecardWeight[Weight] )
			RETURN IF ( NOT HASONEVALUE ( dim_ScorecardWeight[CategoryKey] ), [Project Scorecard],
			IF ( ISBLANK ( S ), BLANK (), DIVIDE ( S * W, 3 ) ) )
		formatString: "0.000"
		displayFolder: 12 Scorecard

	/// Replaces derived - the band the driver fell in, in the seed table's own words
	measure 'Category Band' =
			VAR K = SELECTEDVALUE ( dim_ScorecardWeight[CategoryKey] )
			VAR S = [Category Score]
			RETURN
			IF ( NOT HASONEVALUE ( dim_ScorecardWeight[CategoryKey] ), BLANK (),
			IF (
			ISBLANK ( S ),
			"Not measured",
			CALCULATE (
			MAX ( dim_ScorecardBand[BandLabel] ),
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = K,
			dim_ScorecardBand[Score] = S
			)
			) )
		displayFolder: 12 Scorecard

	column _placeholder
		isHidden
		dataType: string
		summarizeBy: none
		sourceColumn: _placeholder

	column _built_at
		isHidden
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		summarizeBy: none
		sourceColumn: _built_at

	partition _Measures = entity
		mode: directLake
		source
			entityName: measures_anchor
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
