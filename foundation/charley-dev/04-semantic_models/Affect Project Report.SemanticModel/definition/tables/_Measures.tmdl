table _Measures

	/// Replaces FINANCIALS!C3
	measure 'Original Contract' =
			VAR EndDate = MAX ( dim_Date[Date] )
			RETURN CALCULATE ( SUMX ( VALUES ( fct_FinancialPeriod[ProjectKey] ),
			CALCULATE ( LASTNONBLANKVALUE ( dim_Date[Date], SUM ( fct_FinancialPeriod[OriginalContract] ) ) ) ),
			REMOVEFILTERS ( dim_Date ), dim_Date[Date] <= EndDate )
		formatString: "$#,0"
		displayFolder: 01 Contract & Change

	/// Replaces FINANCIALS!C4
	measure 'Current Contract' =
			VAR EndDate = MAX ( dim_Date[Date] )
			RETURN CALCULATE ( SUMX ( VALUES ( fct_FinancialPeriod[ProjectKey] ),
			CALCULATE ( LASTNONBLANKVALUE ( dim_Date[Date], SUM ( fct_FinancialPeriod[CurrentContract] ) ) ) ),
			REMOVEFILTERS ( dim_Date ), dim_Date[Date] <= EndDate )
		formatString: "$#,0"
		displayFolder: 01 Contract & Change

	/// Replaces DASHBOARD!AT11
	measure 'Contract Growth %' = DIVIDE ( [Current Contract] - [Original Contract], [Original Contract] )
		formatString: "0.0%"
		displayFolder: 01 Contract & Change

	/// Replaces FINANCIALS!C5 - was =65000+3158.46+11550+4620 typed in a value cell
	measure 'Pending Change Orders' =
			VAR EndDate = MAX ( dim_Date[Date] )
			RETURN CALCULATE ( SUMX ( VALUES ( fct_FinancialPeriod[ProjectKey] ),
			CALCULATE ( LASTNONBLANKVALUE ( dim_Date[Date], SUM ( fct_FinancialPeriod[PendingChangeOrders] ) ) ) ),
			REMOVEFILTERS ( dim_Date ), dim_Date[Date] <= EndDate )
		formatString: "$#,0"
		displayFolder: 01 Contract & Change

	/// Replaces FINANCIALS!C6 - typed by hand
	measure 'Age Of Oldest Unapproved CO' = MAX ( fct_FinancialPeriod[AgeOfOldestUnapprovedCO] )
		formatString: "#,0"
		displayFolder: 01 Contract & Change

	/// Replaces derived - approved COs, the complement of [Pending Change Orders]
	measure 'Approved Change Orders' = CALCULATE ( SUM ( fct_ChangeOrder[Amount] ), NOT fct_ChangeOrder[IsPending], fct_ChangeOrder[StatusLabel] <> "void" )
		formatString: "$#,0"
		displayFolder: 01 Contract & Change

	/// Replaces change-order grain; responds to status and item filters
	measure 'Change Order Amount' = SUM ( fct_ChangeOrder[Amount] )
		formatString: "$#,0"
		displayFolder: 01 Contract & Change

	/// Replaces derived - pending change orders, counted
	measure 'Outstanding CO Count' = COALESCE ( CALCULATE ( COUNTROWS ( fct_ChangeOrder ), fct_ChangeOrder[IsPending] = TRUE ), 0 )
		formatString: "#,0"
		displayFolder: 01 Contract & Change

	/// Replaces derived - mean age of pending change orders
	measure 'Avg CO Days Open' = AVERAGEX ( FILTER ( fct_ChangeOrder, fct_ChangeOrder[IsPending] ), fct_ChangeOrder[DaysOpen] )
		formatString: "#,0"
		displayFolder: 01 Contract & Change

	/// Replaces derived - pending change orders open more than 30 days
	measure 'COs Over 30 Days' = COALESCE ( CALCULATE ( COUNTROWS ( fct_ChangeOrder ), fct_ChangeOrder[IsPending] = TRUE, fct_ChangeOrder[DaysOpen] > 30 ), 0 )
		formatString: "#,0"
		displayFolder: 01 Contract & Change

	/// Replaces FINANCIALS!C19:C20 - as of the last budget snapshot
	measure 'Budget' = CALCULATE ( SUM ( fct_BudgetLine[BudgetAmount] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces FINANCIALS!D19:D20 - as of the last budget snapshot
	measure 'Forecast' = CALCULATE ( SUM ( fct_BudgetLine[ForecastAmount] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces FINANCIALS!D61 - as of the last budget snapshot
	measure 'Committed' = CALCULATE ( SUM ( fct_BudgetLine[CommittedAmount] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces FINANCIALS!E19:E20 - as of the last budget snapshot
	measure 'Spent To Date' = CALCULATE ( SUM ( fct_BudgetLine[SpentToDate] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces FINANCIALS!C15 - as of the last budget snapshot
	measure 'Cost To Complete' = CALCULATE ( SUM ( fct_BudgetLine[CostToComplete] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces derived - budget less spend to date
	measure 'Budget Remaining' = [Budget] - [Spent To Date]
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces the rule written out in FINANCIALS!H18:J21 but hand-picked from a dropdown
	measure 'Budget Remaining %' = DIVIDE ( [Budget Remaining], [Budget] )
		formatString: "0.0%"
		displayFolder: 02 Budget & Cost

	/// Replaces derived - budget less forecast final cost; negative = forecast over budget
	measure 'Forecast Variance' = [Budget] - [Forecast]
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces derived
	measure 'Forecast Variance %' = DIVIDE ( [Forecast Variance], [Budget] )
		formatString: "0.0%"
		displayFolder: 02 Budget & Cost

	/// Replaces FINANCIALS!F19:F20 bands applied to spend-to-date; not a forecast or completion assessment
	measure 'Budget Status' =
			VAR V = [Budget Remaining %]
			RETURN SWITCH ( TRUE(), ISBLANK ( V ), BLANK (), V >= 0, "Spend within budget", V >= -0.05, "Spend over budget up to 5%", "Spend over budget above 5%" )
		displayFolder: 02 Budget & Cost

	/// Replaces FINANCIALS!F19:F20 bands applied to forecast final cost against budget
	measure 'Forecast Status' =
			VAR V = [Forecast Variance %]
			RETURN SWITCH ( TRUE(), ISBLANK ( V ), BLANK (), V >= 0, "Forecast within budget", V >= -0.05, "Forecast over budget up to 5%", "Forecast over budget above 5%" )
		displayFolder: 02 Budget & Cost

	/// Replaces FINANCIALS!D62
	measure 'Percent Bought Out' = DIVIDE ( [Committed], [Budget] )
		formatString: "0.0%"
		displayFolder: 02 Budget & Cost

	/// Replaces no workbook equivalent - Sage AP job cost (GL 50000-50999 on a job mapped to a Procore project), to date. AP history starts 2025-03-11. NOT added to Spent To Date (no double counting)
	measure 'AP Job Cost' =
			CALCULATE ( SUM ( fct_ApInvoice[LineTotal] ), fct_ApInvoice[IsJobCost] = TRUE (),
			NOT ISBLANK ( fct_ApInvoice[ProjectKey] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces no workbook equivalent - [AP Job Cost] minus [Spent To Date], BLANK when either is blank. AP history starts 2025-03-11, so older jobs read Procore-high for timing. AP is NOT added to Spent To Date
	measure 'AP vs Procore Spent Variance' =
			VAR AP = [AP Job Cost]
			VAR Spent = [Spent To Date]
			RETURN IF ( ISBLANK ( AP ) || ISBLANK ( Spent ), BLANK (), AP - Spent )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces no workbook equivalent - [AP Job Cost] over [Spent To Date]. AP history starts 2025-03-11; AP is NOT added to Spent To Date
	measure 'AP / Procore Spent Ratio' = DIVIDE ( [AP Job Cost], [Spent To Date] )
		formatString: "0.00"
		displayFolder: 02 Budget & Cost

	/// Replaces no workbook equivalent - AP job cost at vendors with no Procore commitment or direct cost on the project: cost Spent To Date cannot contain. AP history starts 2025-03-11; NOT added to Spent To Date
	measure 'ERP-only Vendor Cost' =
			CALCULATE ( SUM ( fct_ApInvoice[LineTotal] ), fct_ApInvoice[IsErpOnlyVendor] = TRUE (),
			NOT ISBLANK ( fct_ApInvoice[ProjectKey] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "$#,0"
		displayFolder: 02 Budget & Cost

	/// Replaces nothing - when the last PUBLISHED run passed the DQ gate, not when gold was last built
	measure 'Last Checked Run' = MAX ( meta_PipelineRun[RunAt] )
		formatString: "yyyy-mm-dd hh:nn"
		displayFolder: 14 Pipeline liveness

	/// Replaces nothing - hours since the last PUBLISHED validated run: automatic update is off, so the model only moves when cd_50_publish_models frames a run that passed the DQ gate. A blocked gate is NOT visible here (the model keeps the last good run); the alert is the signal
	measure 'Hours Since Last Checked Run' =
			VAR Last = MAX ( meta_PipelineRun[RunAt] )
			RETURN IF ( ISBLANK ( Last ), BLANK (), DATEDIFF ( Last, UTCNOW (), HOUR ) )
		formatString: "#,0"
		displayFolder: 14 Pipeline liveness

	/// Replaces nothing - status of the last PUBLISHED validated run, as text so it survives greyscale. A blocked gate never publishes, so BLOCKED is not expected in-model; the alert is the signal
	measure 'Pipeline Status' =
			VAR Last = MAX ( meta_PipelineRun[RunAt] )
			VAR Built = [Last Refresh]
			VAR Latest = FILTER ( ALL ( meta_PipelineRun ), meta_PipelineRun[RunAt] = Last )
			VAR Blocked = COUNTROWS ( FILTER ( Latest, meta_PipelineRun[Status] <> "ok" || meta_PipelineRun[Blocking] > 0 ) )
			VAR Warnings = SUMX ( Latest, meta_PipelineRun[Failing] )
			VAR Hrs = DATEDIFF ( Last, UTCNOW (), HOUR )
			RETURN SWITCH ( TRUE (),
			ISBLANK ( Last ), "Unknown - no checked run",
			Built > Last, "Unvalidated - data built after last check",
			Blocked > 0, "BLOCKED - validation failed",
			Hrs < 0, "Unknown - check timestamp is in the future",
			Hrs > 72, "STALE - no checked run in over 72 hours",
			Hrs > 30, "Late - no checked run in over 30 hours",
			Warnings > 0, "Data checks passed with warnings; source totals not verified",
			"Data checks passed; source totals not verified" )
		displayFolder: 14 Pipeline liveness

	/// Replaces derived
	measure 'Blocking Violations Last Run' =
			VAR Last = MAX ( meta_PipelineRun[RunAt] )
			RETURN IF ( ISBLANK ( Last ), BLANK (), COALESCE ( CALCULATE ( SUM ( meta_PipelineRun[Blocking] ),
			meta_PipelineRun[RunAt] = Last ), 0 ) )
		formatString: "#,0"
		displayFolder: 14 Pipeline liveness

	/// Replaces no workbook equivalent - vendor spend could not be sliced by cost code
	measure 'Vendor Spend' = CALCULATE ( SUM ( bridge_VendorCostCode[Amount] ), bridge_VendorCostCode[AmountType] = "Actual" )
		formatString: "$#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces FINANCIALS!D61 - committed by vendor and cost code, which the workbook cannot slice
	measure 'Vendor Committed' = CALCULATE ( SUM ( bridge_VendorCostCode[Amount] ), bridge_VendorCostCode[AmountType] = "Committed" )
		formatString: "$#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces derived
	measure 'Cost Codes Per Vendor' = COALESCE ( DISTINCTCOUNT ( bridge_VendorCostCode[CostCodeKey] ), 0 )
		formatString: "#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces derived
	measure 'Vendors Per Cost Code' = COALESCE ( DISTINCTCOUNT ( bridge_VendorCostCode[VendorKey] ), 0 )
		formatString: "#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces D8
	measure 'Certificates On File' = COALESCE ( IF ( ISFILTERED ( dim_Project ), CALCULATE ( COUNTROWS ( fct_VendorInsurance ), TREATAS ( VALUES ( bridge_ProjectVendor[VendorKey] ), fct_VendorInsurance[VendorKey] ) ), COUNTROWS ( fct_VendorInsurance ) ), 0 )
		formatString: "#,0"
		displayFolder: 15 Insurance

	/// Replaces D8 - certificate list rows; blank where a vendor has no such certificate
	measure 'Certificates Listed' = IF ( ISFILTERED ( dim_Project ), CALCULATE ( COUNTROWS ( fct_VendorInsurance ), TREATAS ( VALUES ( bridge_ProjectVendor[VendorKey] ), fct_VendorInsurance[VendorKey] ) ), COUNTROWS ( fct_VendorInsurance ) )
		formatString: "#,0"
		displayFolder: 15 Insurance

	/// Replaces D8
	measure 'Vendors With Insurance' = COALESCE ( IF ( ISFILTERED ( dim_Project ), CALCULATE ( DISTINCTCOUNT ( fct_VendorInsurance[VendorKey] ), TREATAS ( VALUES ( bridge_ProjectVendor[VendorKey] ), fct_VendorInsurance[VendorKey] ) ), DISTINCTCOUNT ( fct_VendorInsurance[VendorKey] ) ), 0 )
		formatString: "#,0"
		displayFolder: 15 Insurance

	/// Replaces D8
	measure 'Expired Certificates' = COALESCE ( IF ( ISFILTERED ( dim_Project ), CALCULATE ( CALCULATE ( COUNTROWS ( fct_VendorInsurance ), fct_VendorInsurance[ExpiryStatus] = "Expired" ), TREATAS ( VALUES ( bridge_ProjectVendor[VendorKey] ), fct_VendorInsurance[VendorKey] ) ), CALCULATE ( COUNTROWS ( fct_VendorInsurance ), fct_VendorInsurance[ExpiryStatus] = "Expired" ) ), 0 )
		formatString: "#,0"
		displayFolder: 15 Insurance

	/// Replaces D8 - the renewals to chase this month
	measure 'Certificates Expiring Soon' = COALESCE ( IF ( ISFILTERED ( dim_Project ), CALCULATE ( CALCULATE ( COUNTROWS ( fct_VendorInsurance ), fct_VendorInsurance[ExpiryStatus] = "Expiring within 30 days" ), TREATAS ( VALUES ( bridge_ProjectVendor[VendorKey] ), fct_VendorInsurance[VendorKey] ) ), CALCULATE ( COUNTROWS ( fct_VendorInsurance ), fct_VendorInsurance[ExpiryStatus] = "Expiring within 30 days" ) ), 0 )
		formatString: "#,0"
		displayFolder: 15 Insurance

	/// Replaces D8 - latest certificate expiration on file
	measure 'Latest Certificate Expiration' = MAX ( fct_VendorInsurance[ExpirationDate] )
		formatString: "yyyy-mm-dd"
		displayFolder: 15 Insurance

	/// Replaces D8 - a vendor with no certificate never appears in the insurance table
	measure 'Vendors Without Insurance' =
			VAR Insured = VALUES ( fct_VendorInsurance[VendorKey] )
			RETURN COALESCE ( COUNTROWS ( EXCEPT (
			VALUES ( bridge_ProjectVendor[VendorKey] ), Insured ) ), 0 )
		formatString: "#,0"
		displayFolder: 15 Insurance

	/// Replaces no workbook equivalent - Sage holds no header retainage
	measure 'Retainage Held Owner' = CALCULATE ( SUM ( fct_Billing[RetainageHeld] ), fct_Billing[IsLatestPeriod] = TRUE (), REMOVEFILTERS ( dim_Date ), fct_Billing[BillingType] = "Owner" )
		formatString: "$#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces no workbook equivalent - latest approved subcontractor pay app per commitment
	measure 'Retainage Held Sub' = CALCULATE ( SUM ( fct_Billing[RetainageHeld] ), fct_Billing[IsLatestApprovedPeriod] = TRUE (), REMOVEFILTERS ( dim_Date ), fct_Billing[BillingType] = "Subcontractor" )
		formatString: "$#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces derived - Owner-held minus sub-held; negative = Affect holds more than it is owed
	measure 'Net Retainage Position' = [Retainage Held Owner] - [Retainage Held Sub]
		formatString: "$#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces FINANCIALS!C10, sourced from Procore instead of Sage
	measure 'Owner Billed To Date' = CALCULATE ( SUM ( fct_Billing[CompletedToDate] ), fct_Billing[IsLatestPeriod] = TRUE (), REMOVEFILTERS ( dim_Date ), fct_Billing[BillingType] = "Owner" )
		formatString: "$#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces FINANCIALS!C4, cross-check on [Current Contract]
	measure 'Owner Contract Sum' = CALCULATE ( SUM ( fct_Billing[ContractSumToDate] ), fct_Billing[IsLatestPeriod] = TRUE (), REMOVEFILTERS ( dim_Date ), fct_Billing[BillingType] = "Owner" )
		formatString: "$#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces derived - contract sum less completed, including retainage
	measure 'Balance To Finish' = CALCULATE ( SUM ( fct_Billing[BalanceToFinish] ), fct_Billing[IsLatestPeriod] = TRUE (), REMOVEFILTERS ( dim_Date ), fct_Billing[BillingType] = "Owner" )
		formatString: "$#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces derived - owner billed net of retainage (payment due, Procore); safe to sum, unlike the cumulative columns
	measure 'Billed This Period' = CALCULATE ( SUM ( fct_Billing[CurrentPaymentDue] ), fct_Billing[BillingType] = "Owner", fct_Billing[StatusLabel] <> "DRAFT" )
		formatString: "$#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces derived
	measure 'Billing Periods' = COALESCE ( COUNTROWS ( fct_Billing ), 0 )
		formatString: "#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces derived - what is sitting unissued at month end
	measure 'Draft Billings' = COALESCE ( CALCULATE ( COUNTROWS ( fct_Billing ), fct_Billing[StatusLabel] = "DRAFT" ), 0 )
		formatString: "#,0"
		displayFolder: 03 Billing & Retainage

	/// Replaces no workbook equivalent - self-performed cost was never captured
	measure 'Direct Costs' = SUM ( fct_DirectCost[GrandTotal] )
		formatString: "$#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces no workbook equivalent
	measure 'Self Performed Labour' = CALCULATE ( SUM ( fct_DirectCost[GrandTotal] ), fct_DirectCost[CostType] = "payroll" )
		formatString: "$#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces derived - cost committed but not yet approved
	measure 'Unapproved Direct Costs' = CALCULATE ( SUM ( fct_DirectCost[GrandTotal] ), fct_DirectCost[IsApproved] = FALSE () )
		formatString: "$#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces D8 - the vendor list, assembled by hand from Procore today
	measure 'Vendors On Project' = COALESCE ( DISTINCTCOUNT ( bridge_ProjectVendor[VendorKey] ), 0 )
		formatString: "#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces derived
	measure 'Vendors Missing From ERP' = COALESCE ( CALCULATE ( DISTINCTCOUNT ( bridge_ProjectVendor[VendorKey] ), bridge_ProjectVendor[IsMissingFromErp] = TRUE () ), 0 )
		formatString: "#,0"
		displayFolder: 04 Direct Costs & Vendors

	/// Replaces FINANCIALS!C10
	measure 'Total Billed' = SUM ( fct_Invoice[Amount] )
		formatString: "$#,0"
		displayFolder: 05 Cash & AR

	/// Replaces FINANCIALS!C12 - paid on invoices SENT in the period, not cash received in it
	measure 'Total Paid' = SUM ( fct_Invoice[AmountPaid] )
		formatString: "$#,0"
		displayFolder: 05 Cash & AR

	/// Replaces no workbook equivalent - invoices fully paid in the period, by paid date
	measure 'Cash Received' =
			CALCULATE ( SUM ( fct_Invoice[AmountPaid] ), NOT ISBLANK ( fct_Invoice[PaidDate] ),
			USERELATIONSHIP ( fct_Invoice[PaidDate], dim_Date[Date] ) )
		formatString: "$#,0"
		displayFolder: 05 Cash & AR

	/// Replaces FINANCIALS!F57
	measure 'AR Outstanding' = SUM ( fct_Invoice[Balance] )
		formatString: "$#,0"
		displayFolder: 05 Cash & AR

	/// Replaces DASHBOARD!AT15 - billed to date at period end over contract; was a TEXT string
	measure 'Total Billed %' =
			DIVIDE ( CALCULATE ( SUM ( fct_Invoice[Amount] ), fct_Invoice[HasUnmatchedProject] <> TRUE (),
			FILTER ( ALL ( dim_Date ), dim_Date[Date] <= MAX ( dim_Date[Date] ) ) ),
			[Current Contract] )
		formatString: "0.0%"
		displayFolder: 05 Cash & AR

	/// Replaces replaces the hand-keyed LAST PERIOD column
	measure 'Total Billed MoM %' =
			VAR Prior = CALCULATE ( [Total Billed], DATEADD ( dim_Date[Date], -1, MONTH ) )
			RETURN DIVIDE ( [Total Billed] - Prior, Prior )
		formatString: "0.0%"
		displayFolder: 05 Cash & AR

	/// Replaces SUBMITTALS & RFI!D
	measure 'Open Submittals' = CALCULATE ( COUNTROWS ( fct_RfiSubmittal ), fct_RfiSubmittal[IsOpen] = TRUE, fct_RfiSubmittal[ItemType] = "Submittal" )
		formatString: "#,0"
		displayFolder: 06 Submittals & RFIs

	/// Replaces derived - the workbook has no equivalent
	measure 'Open Submittals Past Due' = CALCULATE ( COUNTROWS ( fct_RfiSubmittal ), fct_RfiSubmittal[IsPastDue] = TRUE, fct_RfiSubmittal[ItemType] = "Submittal" )
		formatString: "#,0"
		displayFolder: 06 Submittals & RFIs

	/// Replaces QUALITY!D39 - typed by hand
	measure 'Avg Days Open' = CALCULATE ( AVERAGE ( fct_RfiSubmittal[DaysOpen] ), fct_RfiSubmittal[IsOpen] = TRUE )
		formatString: "#,0.0"
		displayFolder: 06 Submittals & RFIs

	/// Replaces derived - drafts are not yet submitted, so excluded from Open Submittals
	measure 'Draft Submittals' = CALCULATE ( COUNTROWS ( fct_RfiSubmittal ), fct_RfiSubmittal[IsDraft] = TRUE, fct_RfiSubmittal[ItemType] = "Submittal" )
		formatString: "#,0"
		displayFolder: 06 Submittals & RFIs

	/// Replaces SCHEDULE!Table5
	measure 'Critical Milestones' =
			VAR N = COUNTROWS ( fct_Milestone )
			RETURN IF ( ISBLANK ( N ) && NOT ISBLANK ( CALCULATE ( COUNTROWS ( fct_Milestone ), REMOVEFILTERS ( dim_Date ) ) ), 0, N )
		formatString: "#,0"
		displayFolder: 07 Schedule

	/// Replaces derived
	measure 'Overdue Milestones' =
			VAR N = CALCULATE ( COUNTROWS ( fct_Milestone ), fct_Milestone[IsOverdue] = TRUE )
			RETURN IF ( ISBLANK ( N ) && NOT ISBLANK ( [Critical Milestones] ), 0, N )
		formatString: "#,0"
		displayFolder: 07 Schedule

	/// Replaces DASHBOARD!L19 (Schedule Performance) - a FRACTION, which the scorecard compared against 5/9/10 (defect #1a)
	measure 'Milestones Overdue %' = DIVIDE ( [Overdue Milestones], [Critical Milestones] )
		formatString: "0.0%"
		displayFolder: 07 Schedule

	/// Replaces derived
	measure 'Avg Milestone Progress' = AVERAGE ( fct_Milestone[PercentComplete] )
		formatString: "0.0%"
		displayFolder: 07 Schedule

	/// Replaces QUALITY!Table18 - typed by hand today
	measure 'Punchlist Items' = COALESCE ( CALCULATE ( COUNTROWS ( fct_QualityItem ), fct_QualityItem[ItemType] = "PunchItem" ), 0 )
		formatString: "#,0"
		displayFolder: 08 Quality

	/// Replaces observations and punch items still outstanding
	measure 'Open Quality Items' = COALESCE ( CALCULATE ( COUNTROWS ( fct_QualityItem ), fct_QualityItem[IsOpen] = TRUE ), 0 )
		formatString: "#,0"
		displayFolder: 08 Quality

	/// Replaces Procore observations still open - today, not month end
	measure 'Open Observations' = CALCULATE ( COUNTROWS ( fct_QualityItem ), fct_QualityItem[IsOpen] = TRUE, fct_QualityItem[ItemType] = "Observation" )
		formatString: "#,0"
		displayFolder: 08 Quality

	/// Replaces Procore punch items still open - today, not month end
	measure 'Open Punch Items' = CALCULATE ( COUNTROWS ( fct_QualityItem ), fct_QualityItem[IsOpen] = TRUE, fct_QualityItem[ItemType] = "PunchItem" )
		formatString: "#,0"
		displayFolder: 08 Quality

	/// Replaces open AND past their due date
	measure 'Quality Items Past Due' = COALESCE ( CALCULATE ( COUNTROWS ( fct_QualityItem ), fct_QualityItem[IsPastDue] = TRUE ), 0 )
		formatString: "#,0"
		displayFolder: 08 Quality

	/// Replaces QUALITY!D38:E38 - hand-computed today
	measure 'Avg Days Past Due' = AVERAGEX ( FILTER ( fct_QualityItem, fct_QualityItem[IsPastDue] = TRUE ), fct_QualityItem[DaysPastDue] )
		formatString: "0.0"
		displayFolder: 08 Quality

	/// Replaces present in Procore AND Sage AND Outbuild
	measure 'Projects Fully Mapped' = COALESCE ( CALCULATE ( COUNTROWS ( dim_ProjectCrosswalk ), dim_ProjectCrosswalk[SystemCount] = 3 ), 0 )
		formatString: "#,0"
		displayFolder: 09 Source Coverage

	/// Replaces all projects in the selected coverage category, including incomplete mappings
	measure 'Projects In Coverage' = COUNTROWS ( dim_ProjectCrosswalk )
		formatString: "#,0"
		displayFolder: 09 Source Coverage

	/// Replaces these read as ZERO revenue everywhere - the most dangerous gap
	measure 'Projects Missing From Sage' = COALESCE ( CALCULATE ( COUNTROWS ( dim_ProjectCrosswalk ), dim_ProjectCrosswalk[IsInSage] = FALSE ), 0 )
		formatString: "#,0"
		displayFolder: 09 Source Coverage

	/// Replaces no milestones - Outbuild is the only milestone source that exists
	measure 'Projects Missing From Outbuild' = COALESCE ( CALCULATE ( COUNTROWS ( dim_ProjectCrosswalk ), dim_ProjectCrosswalk[IsInOutbuild] = FALSE ), 0 )
		formatString: "#,0"
		displayFolder: 09 Source Coverage

	/// Replaces share of projects present in all three systems
	measure 'Source Coverage %' = DIVIDE ( [Projects Fully Mapped], COUNTROWS ( dim_ProjectCrosswalk ) )
		formatString: "0.0%"
		displayFolder: 09 Source Coverage

	/// Replaces nothing - share of budget that rolls up to a new cost code and division
	measure 'Budget On New Cost Codes %' = DIVIDE ( CALCULATE ( [Budget], dim_CostCodeCrosswalk[MappingStatus] IN { "NATIVE_NEW", "MAPPED", "MAPPED_LEGACY" } ), [Budget] )
		formatString: "0.0%"
		displayFolder: 09 Source Coverage

	/// Replaces mostly expected - a vendor invited to bid is not a vendor who was paid
	measure 'Vendors Missing From Sage' = COALESCE ( CALCULATE ( COUNTROWS ( dim_VendorCrosswalk ), dim_VendorCrosswalk[IsInSage] = FALSE ), 0 )
		formatString: "#,0"
		displayFolder: 09 Source Coverage

	/// Replaces diagnostics - cannot join to Sage until fixed
	measure 'DQ Projects Without Crosswalk' = CALCULATE ( COUNTROWS ( dim_Project ), dim_Project[IsInCrosswalk] = FALSE, dim_Project[ProjectKey] <> "UNMATCHED" )
		formatString: "#,0"
		displayFolder: 10 Data Quality

	/// Replaces diagnostics
	measure 'DQ Cost Codes Not In Source' = CALCULATE ( COUNTROWS ( dim_CostCode ), dim_CostCode[IsInSource] = FALSE )
		formatString: "#,0"
		displayFolder: 10 Data Quality

	/// Replaces diagnostics - Excel defect #6, never flagged in the workbook
	measure 'DQ Milestones With Inverted Dates' = CALCULATE ( COUNTROWS ( fct_Milestone ), fct_Milestone[HasDateInversion] = TRUE )
		formatString: "#,0"
		displayFolder: 10 Data Quality

	/// Replaces diagnostics - unmatched AR across all projects; retains the selected month
	measure 'DQ Unmatched Invoices' = CALCULATE ( COUNTROWS ( fct_Invoice ), REMOVEFILTERS ( dim_Project ), fct_Invoice[HasUnmatchedProject] = TRUE )
		formatString: "#,0"
		displayFolder: 10 Data Quality

	/// Replaces unattributed billed amount across all projects; retains the selected month
	measure 'Unmatched Billed Amount - All Projects' = CALCULATE ( SUM ( fct_Invoice[Amount] ), REMOVEFILTERS ( dim_Project ), fct_Invoice[HasUnmatchedProject] = TRUE )
		formatString: "$#,0"
		displayFolder: 10 Data Quality

	/// Replaces nothing - rejects, unmatched AR, unmapped trades, coverage and certificate gaps in one register
	measure 'Data Gaps' = COALESCE ( COUNTROWS ( dq_DataGap ), 0 )
		formatString: "#,0"
		displayFolder: 10 Data Quality

	/// Replaces money carried by data gaps - today only unmatched AR invoices carry an amount
	measure 'Data Gap Amount' = SUM ( dq_DataGap[Amount] )
		formatString: "$#,0"
		displayFolder: 10 Data Quality

	/// Replaces no workbook equivalent - a single snapshot cannot draw a curve
	measure 'Billed Cumulative' = CALCULATE ( [Billed This Period], FILTER ( ALL ( dim_Date ), dim_Date[Date] <= MAX ( dim_Date[Date] ) ) )
		formatString: "$#,0"
		displayFolder: 05 Cash & AR

	/// Replaces the S-curve against the contract line
	measure 'Billed Cumulative % Of Contract' = DIVIDE ( [Billed Cumulative], [Current Contract] )
		formatString: "0.0%"
		displayFolder: 05 Cash & AR

	/// Replaces portfolio scope - projects with financial-period rows in the current filters
	measure 'Projects Reporting' = CALCULATE ( DISTINCTCOUNTNOBLANK ( fct_FinancialPeriod[ProjectKey] ), fct_FinancialPeriod[ProjectKey] <> "UNMATCHED" )
		formatString: "#,0"
		displayFolder: 13 Portfolio

	/// Replaces no workbook equivalent - one workbook per project cannot rank them
	measure 'Projects At Risk' = COUNTROWS ( FILTER ( dim_Project, dim_Project[ProjectKey] <> "UNMATCHED" && [Project Status] = "Active" && [Performance Rating] IN { "Needs Improvement", "Unacceptable" } ) )
		formatString: "#,0"
		displayFolder: 13 Portfolio

	/// Replaces Gantt geometry - the transparent leading bar
	measure 'Milestone Offset Days' =
			VAR StartDate = SELECTEDVALUE ( fct_Milestone[CurrentStart] )
			VAR FinishDate = SELECTEDVALUE ( fct_Milestone[CurrentFinish] )
			VAR Origin = MINX ( FILTER ( ALLSELECTED ( fct_Milestone ), NOT ISBLANK ( fct_Milestone[CurrentStart] ) && NOT ISBLANK ( fct_Milestone[CurrentFinish] ) && fct_Milestone[CurrentFinish] >= fct_Milestone[CurrentStart] ), fct_Milestone[CurrentStart] )
			RETURN IF ( COUNTROWS ( fct_Milestone ) = 1 && NOT ISBLANK ( StartDate ) && NOT ISBLANK ( FinishDate ) && FinishDate >= StartDate && NOT ISBLANK ( Origin ), DATEDIFF ( Origin, StartDate, DAY ), BLANK () )
		formatString: "#,0"
		displayFolder: 07 Schedule

	/// Replaces Gantt geometry - the visible bar
	measure 'Milestone Duration Days' =
			VAR StartDate = SELECTEDVALUE ( fct_Milestone[CurrentStart] )
			VAR FinishDate = SELECTEDVALUE ( fct_Milestone[CurrentFinish] )
			RETURN IF ( COUNTROWS ( fct_Milestone ) = 1 && NOT ISBLANK ( StartDate ) && NOT ISBLANK ( FinishDate ) && FinishDate >= StartDate, DATEDIFF ( StartDate, FinishDate, DAY ), BLANK () )
		formatString: "#,0"
		displayFolder: 07 Schedule

	/// Replaces no workbook equivalent - the Excel could not say when its numbers were true
	measure 'Last Refresh' = MAX ( _Measures[_built_at] )
		formatString: "yyyy-mm-dd hh:nn"
		displayFolder: 00 Report context

	/// Replaces DASHBOARD!AU4 - the month anchor, now driven by the slicer
	measure 'Report Month Label' =
			VAR L = MIN ( dim_Date[MonthStart] )
			VAR H = MAX ( dim_Date[MonthStart] )
			RETURN IF ( NOT ISFILTERED ( dim_Date ), "All months", IF ( L = H, FORMAT ( L, "MMMM YYYY" ), FORMAT ( L, "MMMM YYYY" ) & " - " & FORMAT ( H, "MMMM YYYY" ) ) )
		displayFolder: 00 Report context

	/// Replaces no workbook equivalent - [Open Submittals] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it, not a source freshness guarantee. The last available capture may precede month end
	measure 'Open Submittals (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[OpenSubmittals] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Open Submittals Past Due] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it, not a source freshness guarantee. The last available capture may precede month end
	measure 'Open Submittals Past Due (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[SubmittalsPastDue] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Open RFIs] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it, not a source freshness guarantee. The last available capture may precede month end
	measure 'Open RFIs (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[OpenRfis] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Open Observations] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it, not a source freshness guarantee. The last available capture may precede month end
	measure 'Open Observations (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[OpenObservations] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Open Punch Items] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it, not a source freshness guarantee. The last available capture may precede month end
	measure 'Open Punch Items (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[OpenPunchItems] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [AR Outstanding] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it, not a source freshness guarantee. The last available capture may precede month end
	measure 'AR Outstanding (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[ArOutstanding] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Total Billed] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it, not a source freshness guarantee. The last available capture may precede month end
	measure 'Total Billed (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[BilledToDate] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Budget] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it, not a source freshness guarantee. The last available capture may precede month end
	measure 'Budget (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[BudgetAmount] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Spent To Date] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it, not a source freshness guarantee. The last available capture may precede month end
	measure 'Spent To Date (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[SpentToDate] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Committed] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it, not a source freshness guarantee. The last available capture may precede month end
	measure 'Committed (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[CommittedAmount] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Current Contract] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it, not a source freshness guarantee. The last available capture may precede month end
	measure 'Current Contract (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[CurrentContract] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Pending Change Orders] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it, not a source freshness guarantee. The last available capture may precede month end
	measure 'Pending Change Orders (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[PendingChangeOrders] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - [Approved Change Orders] as saved at the last capture in the period. SnapshotDate is the UTC date of the DQ batch that saved it, not a source freshness guarantee. The last available capture may precede month end
	measure 'Approved Change Orders (Month End)' =
			VAR D = MAX ( fct_DailySnapshot[SnapshotDate] )
			RETURN IF ( ISBLANK ( D ), BLANK (),
			CALCULATE ( SUM ( fct_DailySnapshot[ApprovedChangeOrders] ), fct_DailySnapshot[SnapshotDate] = D ) )
		formatString: "$#,0"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - first saved capture. SnapshotDate is the UTC date of the DQ batch that saved it, not a source freshness guarantee. The last available capture may precede month end
	measure 'Snapshot History Starts' = CALCULATE ( MIN ( fct_DailySnapshot[SnapshotDate] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "yyyy-mm-dd"
		displayFolder: 16 Month-end snapshots

	/// Replaces no workbook equivalent - states where saved history begins
	measure 'Snapshot History Note' =
			VAR F = CALCULATE ( MIN ( fct_DailySnapshot[SnapshotDate] ), REMOVEFILTERS ( dim_Date ) )
			RETURN IF ( ISBLANK ( F ), "No month-end history captured yet",
			"History starts " & FORMAT ( F, "yyyy-MM-dd" ) & "; earlier months are unavailable, not zero" )
		displayFolder: 16 Month-end snapshots

	/// Replaces FINANCIALS!F56 - now from Sage AR receipts (acrpmt)
	measure 'Avg Days To Payment' =
			AVERAGEX (
			FILTER ( fct_Invoice, NOT ISBLANK ( fct_Invoice[DaysToPayment] )
			|| ( fct_Invoice[Balance] > 0 && NOT ISBLANK ( fct_Invoice[SentDate] ) ) ),
			IF ( ISBLANK ( fct_Invoice[DaysToPayment] ),
			DATEDIFF ( fct_Invoice[SentDate], TODAY (), DAY ),
			fct_Invoice[DaysToPayment] )
			)
		formatString: "#,0.0"
		displayFolder: 11 Scorecard drivers

	/// Replaces FINANCIALS!C8 - a human judgement the workbook could already have computed
	measure 'Cash Position %' =
			VAR EndDate = MAX ( dim_Date[Date] )
			RETURN DIVIDE (
			CALCULATE ( [Total Paid] + [AR Outstanding], REMOVEFILTERS ( dim_Date ), dim_Date[Date] <= EndDate ),
			[Cost To Complete] )
		formatString: "0.0%"
		displayFolder: 11 Scorecard drivers

	/// Replaces FINANCIALS!C7 - a genuine human judgement, stays manual
	measure 'Profitability Code' = SELECTEDVALUE ( man_Flags[ProfitabilityCode] )
		displayFolder: 11 Scorecard drivers

	/// Replaces SAFETY!E - Procore /incidents, in the registry but not yet ingested
	measure 'Recordable Incidents' =
			VAR EndDate = MIN ( MAX ( dim_Date[Date] ), TODAY () )
			VAR StartDate = EDATE ( DATE ( YEAR ( EndDate ), MONTH ( EndDate ), 1 ), -11 )
			VAR I = CALCULATE ( SUM ( fct_SafetyMonthly[RecordableIncidents] ), REMOVEFILTERS ( dim_Date ),
			dim_Date[Date] >= StartDate, dim_Date[Date] <= EndDate )
			VAR H = CALCULATE ( SUM ( fct_SafetyMonthly[HoursWorked] ), REMOVEFILTERS ( dim_Date ),
			dim_Date[Date] >= StartDate, dim_Date[Date] <= EndDate )
			RETURN IF ( H > 0 || I > 0, COALESCE ( I, 0 ) )
		formatString: "#,0"
		displayFolder: 11 Scorecard drivers

	/// Replaces SAFETY!D - Sage payroll / ADP / Procore timecards, undecided
	measure 'Hours Worked' =
			VAR H = SUM ( fct_SafetyMonthly[HoursWorked] )
			RETURN IF ( H > 0, H )
		formatString: "#,0"
		displayFolder: 11 Scorecard drivers

	/// Replaces Procore /observations/items - was QUALITY!D, typed by hand
	measure 'Observations' = COALESCE ( CALCULATE ( COUNTROWS ( fct_QualityItem ), fct_QualityItem[ItemType] = "Observation" ), 0 )
		formatString: "#,0"
		displayFolder: 11 Scorecard drivers

	/// Replaces QUALITY!D39 - typed by hand today
	measure 'Avg Observation Days To Close' = AVERAGEX ( FILTER ( fct_QualityItem, fct_QualityItem[ItemType] = "Observation" ), fct_QualityItem[DaysOpen] )
		formatString: "#,0.0"
		displayFolder: 11 Scorecard drivers

	/// Replaces SCORECARD CALC!E28 - now Procore daily logs (manpower entries), not typed
	measure 'Daily Reports Missed' = SUM ( fct_SafetyMonthly[DailyLogsMissed] )
		formatString: "#,0"
		displayFolder: 11 Scorecard drivers

	/// Replaces SCORECARD CALC!E28 - monthly band, averaged over the selected months
	measure 'Daily Reports Missed Per Month' = AVERAGEX ( VALUES ( fct_SafetyMonthly[MonthStart] ), CALCULATE ( SUM ( fct_SafetyMonthly[DailyLogsMissed] ) ) )
		formatString: "#,0.0"
		displayFolder: 11 Scorecard drivers

	/// Replaces no workbook equivalent - data-entry check
	measure 'Last Daily Log' = CALCULATE ( MAX ( fct_SafetyMonthly[LastLogDate] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "yyyy-mm-dd"
		displayFolder: 11 Scorecard drivers

	/// Replaces no workbook equivalent - data-entry check
	measure 'Days Since Daily Log' =
			VAR L = [Last Daily Log]
			RETURN IF ( NOT ISBLANK ( L ), DATEDIFF ( L, TODAY (), DAY ) )
		formatString: "#,0"
		displayFolder: 11 Scorecard drivers

	/// Replaces SCHEDULE!Table5 terminator row - from Outbuild
	measure 'Scheduled Finish' = CALCULATE ( MAX ( fct_Milestone[CurrentFinish] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "yyyy-mm-dd"
		displayFolder: 11 Scorecard drivers

	/// Replaces no workbook equivalent - the 2026-10-13 schedule-overrun rule
	measure 'Schedule Ended Site Active' =
			VAR F = [Scheduled Finish]
			RETURN IF ( NOT ISBLANK ( F ) && F < TODAY (),
			[Last Daily Log] > F
			|| CALCULATE ( [Open Punch Items], REMOVEFILTERS ( dim_Date ) ) > 0 )
		displayFolder: 11 Scorecard drivers

	/// Replaces no workbook equivalent - is the data actually being entered
	measure 'Input Check' =
			VAR F = [Scheduled Finish]
			VAR D = [Days Since Daily Log]
			RETURN
			SWITCH (
			TRUE (),
			[Schedule Ended Site Active], "Schedule ended - site still active",
			NOT ISBLANK ( F ) && F >= TODAY () && ISBLANK ( D ), "No daily logs in Procore",
			NOT ISBLANK ( F ) && F >= TODAY () && D > 7, "No daily log for " & D & " days",
			ISBLANK ( F ) && NOT ISBLANK ( D ) && D <= 30, "No schedule in Outbuild"
			)
		displayFolder: 11 Scorecard drivers

	/// Replaces DASHBOARD!M16 - which returned the TEXT "0 days" (defect #1b); now the Outbuild baseline, or man_Milestones when typed
	measure 'Completion Variance Days' =
			VAR Manual = MAX ( man_Milestones[BaselineFinish] )
			VAR Baseline = IF ( NOT ISBLANK ( Manual ), Manual,
			CALCULATE ( MAX ( fct_Milestone[BaselineFinish] ), REMOVEFILTERS ( dim_Date ) ) )
			VAR Forecast = [Scheduled Finish]
			RETURN IF ( ISBLANK ( Baseline ) || ISBLANK ( Forecast ), BLANK (), DATEDIFF ( Baseline, Forecast, DAY ) )
		formatString: "#,0"
		displayFolder: 11 Scorecard drivers

	/// Replaces SCORECARD CALC!C42
	measure 'Client Satisfaction' = DIVIDE ( SUM ( man_Survey[Score] ), COUNTROWS ( man_Survey ) * 5 )
		formatString: "0.0%"
		displayFolder: 11 Scorecard drivers

	/// Replaces SCORECARD CALC!E13 - FIX: driver is days to payment, not an aging balance (defect #1c)
	measure 'Score - Accounts Receivable' =
			VAR V = [Avg Days To Payment]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 1
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E7
	measure 'Score - Profitability' =
			VAR V = [Profitability Code]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 2
			&& dim_ScorecardBand[MatchValue] = V
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E10 - now computed rather than picked from a dropdown
	measure 'Score - Cash Position' =
			VAR V = [Cash Position %]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 3
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E14
	measure 'Score - Change Orders' =
			VAR V = [Age Of Oldest Unapproved CO]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 4
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E16
	measure 'Score - Safety Incidents' =
			VAR V = [Recordable Incidents]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 5
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E19 - FIX: bands are fractions, so this stops always awarding 3/3 (defect #1a); 0 when the schedule ended but the site is active
	measure 'Score - Schedule Performance' =
			IF ( [Schedule Ended Site Active], 0,
			VAR V = [Milestones Overdue %]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 6
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			) )
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E22 - FIX: numeric, so finishing on baseline scores 3 not 0 (defect #1b)
	measure 'Score - Completion Variance' =
			VAR V = [Completion Variance Days]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 7
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E25
	measure 'Score - Observations' =
			VAR V = [Avg Observation Days To Close]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 8
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E28
	measure 'Score - Daily Reports' =
			VAR V = [Daily Reports Missed Per Month]
			RETURN
			IF (
			ISBLANK ( V ),
			BLANK (),
			MAXX (
			FILTER (
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = 9
			&& ( ISBLANK ( dim_ScorecardBand[MinValue] ) || V >= dim_ScorecardBand[MinValue] )
			&& ( ISBLANK ( dim_ScorecardBand[MaxValue] ) || V < dim_ScorecardBand[MaxValue] )
			),
			dim_ScorecardBand[Score]
			)
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!G31
	measure 'Project Scorecard' =
			IF ( [Scorecard Coverage %] > 0,
			DIVIDE (
			SUMX (
			ALL ( dim_ScorecardWeight ),
			VAR S =
			SWITCH (
			dim_ScorecardWeight[CategoryKey],
			1, [Score - Accounts Receivable],
			2, [Score - Profitability],
			3, [Score - Cash Position],
			4, [Score - Change Orders],
			5, [Score - Safety Incidents],
			6, [Score - Schedule Performance],
			7, [Score - Completion Variance],
			8, [Score - Observations],
			9, [Score - Daily Reports],
			BLANK ()
			)
			RETURN IF ( ISBLANK ( S ), 0, S * dim_ScorecardWeight[Weight] )
			),
			3
			) )
		formatString: "0.00"
		displayFolder: 12 Scorecard

	/// Replaces no equivalent - the workbook could not tell you this
	measure 'Scorecard Coverage %' =
			VAR C =
			SUMX (
			ALL ( dim_ScorecardWeight ),
			VAR S =
			SWITCH (
			dim_ScorecardWeight[CategoryKey],
			1, [Score - Accounts Receivable],
			2, [Score - Profitability],
			3, [Score - Cash Position],
			4, [Score - Change Orders],
			5, [Score - Safety Incidents],
			6, [Score - Schedule Performance],
			7, [Score - Completion Variance],
			8, [Score - Observations],
			9, [Score - Daily Reports],
			BLANK ()
			)
			RETURN IF ( ISBLANK ( S ), 0, dim_ScorecardWeight[Weight] )
			)
			RETURN IF ( C > 0, C )
		formatString: "0.0%"
		displayFolder: 12 Scorecard

	/// Replaces derived - makes partial coverage comparable
	measure 'Project Scorecard (Measured Only)' = DIVIDE ( [Project Scorecard], [Scorecard Coverage %] )
		formatString: "0.00"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!E23:E31 - the per-category score, never displayed in the Excel
	measure 'Category Score' =
			VAR K = SELECTEDVALUE ( dim_ScorecardWeight[CategoryKey] )
			RETURN
			SWITCH (
			K,
			1, [Score - Accounts Receivable],
			2, [Score - Profitability],
			3, [Score - Cash Position],
			4, [Score - Change Orders],
			5, [Score - Safety Incidents],
			6, [Score - Schedule Performance],
			7, [Score - Completion Variance],
			8, [Score - Observations],
			9, [Score - Daily Reports],
			BLANK ()
			)
		formatString: "0"
		displayFolder: 12 Scorecard

	/// Replaces SCORECARD CALC!G23:G31 - ((E*F)/3), the workbook's own normalisation
	measure 'Category Weighted' =
			VAR S = [Category Score]
			VAR W = SELECTEDVALUE ( dim_ScorecardWeight[Weight] )
			RETURN IF ( NOT HASONEVALUE ( dim_ScorecardWeight[CategoryKey] ), [Project Scorecard],
			IF ( ISBLANK ( S ), BLANK (), DIVIDE ( S * W, 3 ) ) )
		formatString: "0.000"
		displayFolder: 12 Scorecard

	/// Replaces derived - the band the driver fell in, in the seed table's own words
	measure 'Category Band' =
			VAR K = SELECTEDVALUE ( dim_ScorecardWeight[CategoryKey] )
			VAR S = [Category Score]
			RETURN
			IF ( NOT HASONEVALUE ( dim_ScorecardWeight[CategoryKey] ), BLANK (),
			IF (
			ISBLANK ( S ),
			"Not measured",
			CALCULATE (
			MAX ( dim_ScorecardBand[BandLabel] ),
			ALL ( dim_ScorecardBand ),
			dim_ScorecardBand[CategoryKey] = K,
			dim_ScorecardBand[Score] = S
			)
			) )
		displayFolder: 12 Scorecard

	/// Replaces derived - [Project Scorecard (Measured Only)] over the selected pillars
	measure 'Pillar Score' =
			VAR T =
			ADDCOLUMNS (
			dim_ScorecardWeight,
			"@S",
			SWITCH (
			dim_ScorecardWeight[CategoryKey],
			1, [Score - Accounts Receivable],
			2, [Score - Profitability],
			3, [Score - Cash Position],
			4, [Score - Change Orders],
			5, [Score - Safety Incidents],
			6, [Score - Schedule Performance],
			7, [Score - Completion Variance],
			8, [Score - Observations],
			9, [Score - Daily Reports],
			BLANK ()
			)
			)
			VAR Measured = SUMX ( FILTER ( T, NOT ISBLANK ( [@S] ) ), dim_ScorecardWeight[Weight] )
			RETURN IF ( Measured > 0 && [Scorecard Coverage %] >= 0.5,
			DIVIDE ( SUMX ( T, [@S] * dim_ScorecardWeight[Weight] ), 3 * Measured ) )
		formatString: "0.00"
		displayFolder: 12 Scorecard

	/// Replaces no workbook equivalent - one workbook per project cannot rank them
	measure 'Project Rank' =
			VAR S = ROUND ( [Pillar Score], 6 )
			RETURN IF ( ISBLANK ( S ), BLANK (),
			RANKX ( ALLSELECTED ( dim_Project ), ROUND ( [Pillar Score], 6 ), S, DESC, DENSE ) )
		formatString: "#,0"
		displayFolder: 12 Scorecard

	/// Replaces derived - the 2026-10-09 'mediocre on several metrics' signal
	measure 'Categories Below Target' =
			IF ( [Scorecard Coverage %] > 0,
			SUMX (
			ALL ( dim_ScorecardWeight ),
			VAR S =
			SWITCH (
			dim_ScorecardWeight[CategoryKey],
			1, [Score - Accounts Receivable],
			2, [Score - Profitability],
			3, [Score - Cash Position],
			4, [Score - Change Orders],
			5, [Score - Safety Incidents],
			6, [Score - Schedule Performance],
			7, [Score - Completion Variance],
			8, [Score - Observations],
			9, [Score - Daily Reports],
			BLANK ()
			)
			RETURN IF ( NOT ISBLANK ( S ) && S < 3, 1, 0 )
			) )
		formatString: "#,0"
		displayFolder: 12 Scorecard

	/// Replaces derived - flags projects below target on several categories
	measure 'Needs Attention' = IF ( [Categories Below Target] >= 2, "Needs attention" )
		displayFolder: 12 Scorecard

	/// Replaces derived - [Pillar Score] for the Financial pillar
	measure 'Financial Score' = CALCULATE ( [Pillar Score], dim_ScorecardWeight[Pillar] = "Financial" )
		formatString: "0.00"
		displayFolder: 12 Scorecard

	/// Replaces derived - [Pillar Score] for the Schedule pillar
	measure 'Schedule Score' = CALCULATE ( [Pillar Score], dim_ScorecardWeight[Pillar] = "Schedule" )
		formatString: "0.00"
		displayFolder: 12 Scorecard

	/// Replaces derived - [Pillar Score] for the Safety & Quality pillar
	measure 'Safety & Quality Score' = CALCULATE ( [Pillar Score], dim_ScorecardWeight[Pillar] = "Safety & Quality" )
		formatString: "0.00"
		displayFolder: 12 Scorecard

	/// Replaces derived - [Pillar Score] for the Reporting pillar
	measure 'Reporting Score' = CALCULATE ( [Pillar Score], dim_ScorecardWeight[Pillar] = "Reporting" )
		formatString: "0.00"
		displayFolder: 12 Scorecard

	/// Replaces Bonus policy p.2 - Needs Improvement if either Safety or Quality is subpar
	measure 'Safety Quality Gate' =
			VAR A = [Score - Safety Incidents]
			VAR B = [Score - Observations]
			RETURN IF ( NOT ISBLANK ( A ) || NOT ISBLANK ( B ),
			( NOT ISBLANK ( A ) && A < 3 ) || ( NOT ISBLANK ( B ) && B < 3 ) )
		displayFolder: 12 Scorecard

	/// Replaces Bonus policy p.1 - performance score tier multiplier (cut-offs proposed)
	measure 'Bonus Multiplier %' =
			VAR R = [Project Scorecard (Measured Only)]
			VAR S = IF ( NOT ISBLANK ( R ), ROUND ( R, 2 ) )
			VAR M =
			SWITCH ( TRUE (),
			S >= 0.9, 150,
			S >= 0.75, 115,
			S >= 0.6, 100,
			S >= 0.4, 50,
			0 )
			VAR Cap = 50
			RETURN IF ( NOT ISBLANK ( S ) && [Scorecard Coverage %] >= 0.5,
			DIVIDE ( IF ( [Safety Quality Gate], MIN ( M, Cap ), M ), 100 ) )
		formatString: "0%"
		displayFolder: 12 Scorecard

	/// Replaces Bonus policy p.1 - Outstanding / Exceeds / Meets / Needs Improvement / Unacceptable
	measure 'Performance Rating' =
			VAR M = [Bonus Multiplier %] * 100
			RETURN IF ( ISBLANK ( M ),
			IF ( [Scorecard Coverage %] > 0, "Not enough data" ),
			SWITCH ( TRUE (),
			M >= 149.5, "Outstanding",
			M >= 114.5, "Exceeds Expectations",
			M >= 99.5, "Meets Expectations",
			M >= 49.5, "Needs Improvement",
			"Unacceptable" ) )
		displayFolder: 12 Scorecard

	/// Replaces Bonus policy p.2 - which below-target category capped the rating
	measure 'Rating Cap' =
			VAR A = [Score - Safety Incidents]
			VAR B = [Score - Observations]
			VAR LowA = NOT ISBLANK ( A ) && A < 3
			VAR LowB = NOT ISBLANK ( B ) && B < 3
			RETURN IF ( NOT ISBLANK ( [Bonus Multiplier %] )
			&& ROUND ( [Project Scorecard (Measured Only)], 2 ) >= 0.6 && ( LowA || LowB ),
			"Capped by " & IF ( LowA, "Safety Incidents" ) & IF ( LowA && LowB, " and " ) & IF ( LowB, "Observations" ) )
		displayFolder: 12 Scorecard

	/// Replaces derived - [Performance Rating] plus the Safety & Quality cap, when it applied
	measure 'Bonus Rating' =
			VAR R = [Performance Rating]
			VAR C = [Rating Cap]
			RETURN IF ( ISBLANK ( C ), R, R & " (" & LOWER ( LEFT ( C, 1 ) ) & MID ( C, 2, 100 ) & ")" )
		displayFolder: 12 Scorecard

	/// Replaces derived - the category costing the project most, e.g. "Observations 0/3 +1 more"
	measure 'Main Issue' =
			VAR T =
			FILTER (
			ADDCOLUMNS (
			ALL ( dim_ScorecardWeight ),
			"@S",
			SWITCH (
			dim_ScorecardWeight[CategoryKey],
			1, [Score - Accounts Receivable],
			2, [Score - Profitability],
			3, [Score - Cash Position],
			4, [Score - Change Orders],
			5, [Score - Safety Incidents],
			6, [Score - Schedule Performance],
			7, [Score - Completion Variance],
			8, [Score - Observations],
			9, [Score - Daily Reports],
			BLANK ()
			)
			),
			NOT ISBLANK ( [@S] ) && [@S] < 3
			)
			VAR Lo = MINX ( T, [@S] )
			VAR W = TOPN ( 1, FILTER ( T, [@S] = Lo ), dim_ScorecardWeight[Weight], DESC,
			dim_ScorecardWeight[SortOrder], ASC )
			VAR N = COUNTROWS ( T )
			RETURN IF ( NOT ISBLANK ( Lo ), MAXX ( W, dim_ScorecardWeight[CategoryName] ) & " " & Lo & "/3"
			& IF ( N > 1, " +" & ( N - 1 ) & " more" ) )
		displayFolder: 12 Scorecard

	/// Replaces no workbook equivalent - Active = a Procore daily log in the last 60 days
	measure 'Project Status' =
			VAR K = SELECTEDVALUE ( dim_Project[ProjectKey] )
			VAR D = [Days Since Daily Log]
			RETURN IF ( NOT ISBLANK ( K ) && K <> "UNMATCHED",
			IF ( ISBLANK ( D ), "No daily logs", IF ( D <= 60, "Active", "Inactive" ) ) )
		displayFolder: 12 Scorecard

	/// Replaces derived - the overall score, coverage-gated, whatever pillar is selected
	measure 'Health Score' = CALCULATE ( [Pillar Score], REMOVEFILTERS ( dim_ScorecardWeight ) )
		formatString: "0.00"
		displayFolder: 12 Scorecard

	/// Replaces derived - which categories the score table lists
	measure 'Score Table Pillars' =
			IF ( COUNTROWS ( dim_ScorecardWeight ) < COUNTROWS ( ALL ( dim_ScorecardWeight ) ),
			CONCATENATEX ( VALUES ( dim_ScorecardWeight[Pillar] ), dim_ScorecardWeight[Pillar], ", ",
			dim_ScorecardWeight[Pillar], ASC ) & " only",
			"All categories" )
		displayFolder: 12 Scorecard

	/// Replaces derived - [Input Check], or No issues
	measure 'Input Check Status' = COALESCE ( [Input Check], "No issues" )
		displayFolder: 12 Scorecard

	/// Replaces display label for fct_Milestone[IsOverdue]
	measure 'Milestone Overdue' = IF ( CALCULATE ( COUNTROWS ( fct_Milestone ), fct_Milestone[IsOverdue] = TRUE () ) > 0, "Overdue", "" )
		displayFolder: 12 Scorecard

	/// Replaces display label for fct_QualityItem[ItemType]
	measure 'Item Type Label' =
			VAR T = SELECTEDVALUE ( fct_QualityItem[ItemType] )
			RETURN IF ( T = "PunchItem", "Punch item", T )
		displayFolder: 12 Scorecard

	/// Replaces display label for fct_ChangeOrder[StatusLabel]
	measure 'CO Status' =
			VAR T = SELECTEDVALUE ( fct_ChangeOrder[StatusLabel] )
			RETURN IF ( NOT ISBLANK ( T ),
			UPPER ( LEFT ( T, 1 ) ) & LOWER ( SUBSTITUTE ( MID ( T, 2, 200 ), "_", " " ) ) )
		displayFolder: 12 Scorecard

	/// Replaces deck slide 3 - the time-window selection box, defaulting to current
	measure 'Report Week End' =
			VAR Picked = IF ( HASONEVALUE ( dim_ReportWeek[WeekEnd] ), VALUES ( dim_ReportWeek[WeekEnd] ) )
			RETURN IF ( ISBLANK ( Picked ),
			CALCULATE ( MAX ( dim_ReportWeek[WeekEnd] ), REMOVEFILTERS ( dim_ReportWeek ), dim_ReportWeek[WeeksAgo] = 1 ),
			Picked )
		formatString: "yyyy-mm-dd"
		displayFolder: 20 Dashboard - week & status

	/// Replaces the gold build date; today's balances are as of this day
	measure 'Data As Of' = CALCULATE ( MAX ( dim_ReportWeek[AsOfDate] ), REMOVEFILTERS ( dim_ReportWeek ) )
		formatString: "yyyy-mm-dd"
		displayFolder: 20 Dashboard - week & status

	/// Replaces derived
	measure 'Report Window End' = MIN ( [Report Week End], [Data As Of] )
		formatString: "yyyy-mm-dd"
		displayFolder: 20 Dashboard - week & status

	/// Replaces derived
	measure 'Report Weeks Ago' = IF ( HASONEVALUE ( dim_ReportWeek[WeeksAgo] ), VALUES ( dim_ReportWeek[WeeksAgo] ), 1 )
		formatString: "0"
		displayFolder: 20 Dashboard - week & status

	/// Replaces deck header - the week the page reports
	measure 'Report Week Label' =
			VAR E = [Report Week End]
			VAR S = E - 6
			VAR W = [Report Weeks Ago]
			RETURN SWITCH ( W, 0, "This week", 1, "Last week", "Week" ) & "  "
			& FORMAT ( S, "mmm d" ) & " - " & FORMAT ( E, "mmm d, yyyy" )
		displayFolder: 20 Dashboard - week & status

	/// Replaces derived - one real project in context
	measure 'Is Dashboard Project' =
			VAR K = SELECTEDVALUE ( dim_Project[ProjectKey] )
			RETURN NOT ISBLANK ( K ) && K <> "UNMATCHED"
		displayFolder: 20 Dashboard - week & status

	/// Replaces the current contract as of the build - the latest month with a value
	measure 'Position Contract' = SUM ( fct_ProjectPosition[CurrentContract] )
		formatString: "$#,0"
		displayFolder: 20 Dashboard - week & status

	/// Replaces deck slide 3 BILLED TO DATE - Procore owner pay apps (gross), else Sage AR
	measure 'Billed To Date (Gross)' = SUM ( fct_ProjectPosition[BilledToDateGross] )
		formatString: "$#,0"
		displayFolder: 20 Dashboard - week & status

	/// Replaces deck slide 3 BILLING PROGRESS; slide 2 'Determine phase based on Billed %'
	measure 'Billed % Of Contract' = DIVIDE ( [Billed To Date (Gross)], [Position Contract] )
		formatString: "0.0%"
		displayFolder: 20 Dashboard - week & status

	/// Replaces deck slide 2: <10% Precon, 10-95% Construction, >95% Closeout
	measure 'Project Phase' =
			VAR B = [Billed % Of Contract]
			RETURN IF ( NOT ISBLANK ( B ), SWITCH ( TRUE (), B < CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "phase_precon_below" ), "Precon",
			B > CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "phase_closeout_from" ), "Closeout", "Construction" ) )
		displayFolder: 20 Dashboard - week & status

	/// Replaces deck slide 2 CURRENT PHASE
	measure 'Phase Label' = COALESCE ( [Project Phase], "Not supplied" )
		displayFolder: 20 Dashboard - week & status

	/// Replaces derived - latest daily log, meeting, inspection, RFI/submittal or observation
	measure 'Last Project Activity' = MAX ( fct_ProjectPosition[LastActivityDate] )
		formatString: "yyyy-mm-dd"
		displayFolder: 20 Dashboard - week & status

	/// Replaces Oct 21 call: archived once 100% paid; Active = recent Procore activity (proposed 60 days)
	measure 'Dashboard Status' =
			VAR K = SELECTEDVALUE ( dim_Project[ProjectKey] )
			RETURN IF ( NOT ISBLANK ( K ) && K <> "UNMATCHED", SELECTEDVALUE ( fct_ProjectPosition[DashboardStatus] ) )
		displayFolder: 20 Dashboard - week & status

	/// Replaces Cash Position formula: Billings to Date
	measure 'Cash - Billings To Date' = [Billed To Date (Gross)]
		formatString: "$#,0"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Cash Position formula: Retainage Receivable (Procore owner pay apps)
	measure 'Cash - Retainage Receivable' = SUM ( fct_ProjectPosition[RetainageReceivable] )
		formatString: "$#,0"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Cash Position formula: Unpaid Receivables (billed, not collected - Sage AR)
	measure 'Cash - Unpaid Receivables' = SUM ( fct_ProjectPosition[UnpaidReceivables] )
		formatString: "$#,0"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Cash Position formula: Costs Incurred (Procore job-to-date cost)
	measure 'Cash - Costs Incurred' = SUM ( fct_ProjectPosition[CostsIncurred] )
		formatString: "$#,0"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Cash Position formula: Unpaid Payables (Sage AP job cost)
	measure 'Cash - Unpaid Payables' = SUM ( fct_ProjectPosition[UnpaidPayables] )
		formatString: "$#,0"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Cash Position formula: Retainage Payable to Subs (Procore requisitions)
	measure 'Cash - Retainage Payable' = SUM ( fct_ProjectPosition[RetainagePayable] )
		formatString: "$#,0"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Cash Position formula, inflow half
	measure 'Cash Collected' =
			VAR B = [Cash - Billings To Date]
			RETURN IF ( NOT ISBLANK ( B ), B - [Cash - Retainage Receivable] - [Cash - Unpaid Receivables] )
		formatString: "$#,0"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Cash Position formula, outflow half
	measure 'Cash Paid Out' =
			VAR C = [Cash - Costs Incurred]
			RETURN IF ( NOT ISBLANK ( C ), C - [Cash - Unpaid Payables] - [Cash - Retainage Payable] )
		formatString: "$#,0"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Cash Position = Billings - Retainage Receivable - Unpaid Receivables - (Costs Incurred - Unpaid Payables - Retainage Payable) - Chris, 2026-10-22
	measure 'Cash Position' =
			VAR I = [Cash Collected]
			VAR O = [Cash Paid Out]
			RETURN IF ( NOT ISBLANK ( I ) && NOT ISBLANK ( O ), I - O )
		formatString: "$#,0"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Scorecard.xlsx Cash Position % - collected over paid
	measure 'Cash Collected / Paid' =
			VAR I = [Cash Collected]
			VAR O = [Cash Paid Out]
			RETURN IF ( O > 0, DIVIDE ( I, O ), IF ( NOT ISBLANK ( I ) && NOT ISBLANK ( O ) && I >= 0, 1 ) )
		formatString: "0%"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Procore revised budget, which carries the CM fee and so equals contract revenue
	measure 'Projected Revenue' = SUM ( fct_ProjectPosition[ProjectedRevenue] )
		formatString: "$#,0"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Procore forecast final cost, CM fee excluded
	measure 'Projected Cost' = SUM ( fct_ProjectPosition[ProjectedCost] )
		formatString: "$#,0"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Scorecard.xlsx Profitability (Gross) - DEFINITION TO CONFIRM with Affect
	measure 'Projected Gross Margin %' =
			VAR R = [Projected Revenue]
			VAR C = [Projected Cost]
			RETURN IF ( R > 0 && NOT ISBLANK ( C ), DIVIDE ( R - C, R ) )
		formatString: "0.0%"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Oct 21 call: 12.5%, 13% from the end of Q1 - dim_DashSetting
	measure 'Gross Margin Target' = CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "gross_margin_target" )
		formatString: "0.0%"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces derived - points above (+) or below (-) target
	measure 'Margin vs Target' =
			VAR M = [Projected Gross Margin %]
			RETURN IF ( NOT ISBLANK ( M ), M - [Gross Margin Target] )
		formatString: "+0.0%;-0.0%;0.0%"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Scorecard.xlsx Aging Balance - days, balance-weighted
	measure 'AR Weighted Age Days' =
			VAR Bal = SUM ( fct_ProjectPosition[ArOwedBalance] )
			RETURN IF ( Bal > 0, DIVIDE ( SUM ( fct_ProjectPosition[ArOwedBalanceDays] ), Bal ),
			IF ( SUM ( fct_ProjectPosition[InvoiceCount] ) > 0, 0 ) )
		formatString: "#,0"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces deck slide 1 AR > 60 DAYS - every invoice, matched to a project or not
	measure 'AR Over 60 Days' =
			VAR AsOf = [Data As Of]
			RETURN COALESCE ( SUMX ( FILTER ( CALCULATETABLE ( fct_Invoice, REMOVEFILTERS ( dim_Date ) ),
			fct_Invoice[Balance] > 0 && DATEDIFF ( fct_Invoice[SentDate], AsOf, DAY ) > CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "ar_aged_days" ) ),
			fct_Invoice[Balance] ), 0 )
		formatString: "$#,0"
		displayFolder: 21 Dashboard - budget drivers

	/// Replaces Scorecard.xlsx OAC Meeting - misses, rolling 4 weeks
	measure 'OAC Weeks Missed' =
			VAR E = [Report Week End]
			VAR Weeks = SELECTCOLUMNS ( GENERATESERIES ( 0, 3, 1 ), "@k", [Value] )
			VAR Held = COUNTROWS ( FILTER ( Weeks,
			VAR Hi = E - 7 * [@k]
			VAR Lo = Hi - 6
			RETURN NOT ISEMPTY ( FILTER ( fct_Meeting,
			fct_Meeting[MeetingType] = "OAC" && fct_Meeting[IsCompliant]
			&& fct_Meeting[MeetingDate] >= Lo && fct_Meeting[MeetingDate] <= Hi ) ) ) )
			VAR HeldNow = NOT ISEMPTY ( FILTER ( fct_Meeting,
			fct_Meeting[MeetingType] = "OAC" && fct_Meeting[IsCompliant]
			&& fct_Meeting[MeetingDate] >= E - 6 && fct_Meeting[MeetingDate] <= E ) )
			VAR Open = IF ( [Report Weeks Ago] = 0 && NOT HeldNow, 1, 0 )
			RETURN IF ( [Is Dashboard Project], 4 - COALESCE ( Held, 0 ) - Open )
		formatString: "0"
		displayFolder: 22 Dashboard - schedule & site drivers

	/// Replaces Scorecard.xlsx Trade Partner Meeting - misses, rolling 4 weeks
	measure 'Trade Partner Weeks Missed' =
			VAR E = [Report Week End]
			VAR Weeks = SELECTCOLUMNS ( GENERATESERIES ( 0, 3, 1 ), "@k", [Value] )
			VAR Held = COUNTROWS ( FILTER ( Weeks,
			VAR Hi = E - 7 * [@k]
			VAR Lo = Hi - 6
			RETURN NOT ISEMPTY ( FILTER ( fct_Meeting,
			fct_Meeting[MeetingType] = "Trade Partner" && fct_Meeting[IsCompliant]
			&& fct_Meeting[MeetingDate] >= Lo && fct_Meeting[MeetingDate] <= Hi ) ) ) )
			VAR HeldNow = NOT ISEMPTY ( FILTER ( fct_Meeting,
			fct_Meeting[MeetingType] = "Trade Partner" && fct_Meeting[IsCompliant]
			&& fct_Meeting[MeetingDate] >= E - 6 && fct_Meeting[MeetingDate] <= E ) )
			VAR Open = IF ( [Report Weeks Ago] = 0 && NOT HeldNow, 1, 0 )
			RETURN IF ( [Is Dashboard Project], 4 - COALESCE ( Held, 0 ) - Open )
		formatString: "0"
		displayFolder: 22 Dashboard - schedule & site drivers

	/// Replaces Scorecard.xlsx 3WLA going out once per week - days since the Outbuild look-ahead was worked
	measure 'Days Since Look-Ahead Update' =
			VAR Linked = NOT ISEMPTY ( fct_ScheduleActivity )
			VAR L = MAXX ( { MAX ( fct_LookaheadTask[UpdatedAt] ), MAX ( fct_LookaheadTask[CreatedAt] ) }, [Value] )
			RETURN IF ( [Is Dashboard Project] && Linked && [Report Weeks Ago] <= 1,
			IF ( ISBLANK ( L ), 999, DATEDIFF ( L, [Data As Of], DAY ) ) )
		formatString: "0"
		displayFolder: 22 Dashboard - schedule & site drivers

	/// Replaces Scorecard.xlsx Monthly schedule update - days since an activity was last edited
	measure 'Days Since Schedule Update' =
			VAR L = MAX ( fct_ScheduleActivity[UpdatedAt] )
			RETURN IF ( [Is Dashboard Project] && NOT ISBLANK ( L ) && [Report Weeks Ago] <= 1,
			DATEDIFF ( L, [Data As Of], DAY ) )
		formatString: "0"
		displayFolder: 22 Dashboard - schedule & site drivers

	/// Replaces derived - first baseline start to last baseline finish on the critical path
	measure 'Baseline Duration Days' =
			CALCULATE ( VAR S = MIN ( fct_Milestone[BaselineStart] ) VAR F = MAX ( fct_Milestone[BaselineFinish] )
			RETURN IF ( NOT ISBLANK ( S ) && F > S, DATEDIFF ( S, F, DAY ) ), REMOVEFILTERS ( dim_Date ) )
		formatString: "#,0"
		displayFolder: 22 Dashboard - schedule & site drivers

	/// Replaces Scorecard.xlsx Completion variance - days late over the baseline duration
	measure 'Completion Variance %' = DIVIDE ( [Completion Variance Days], [Baseline Duration Days] )
		formatString: "0.0%"
		displayFolder: 22 Dashboard - schedule & site drivers

	/// Replaces Scorecard.xlsx Submittals - overdue count, today
	measure 'Submittals Overdue' =
			VAR Any = CALCULATE ( COUNTROWS ( fct_RfiSubmittal ), REMOVEFILTERS ( dim_Date ), fct_RfiSubmittal[ItemType] = "Submittal" )
			RETURN IF ( [Is Dashboard Project] && Any > 0,
			COALESCE ( CALCULATE ( [Open Submittals Past Due], REMOVEFILTERS ( dim_Date ) ), 0 ) )
		formatString: "#,0"
		displayFolder: 22 Dashboard - schedule & site drivers

	/// Replaces Scorecard.xlsx RFIs - outstanding count, today
	measure 'RFIs Outstanding' =
			VAR Any = CALCULATE ( COUNTROWS ( fct_RfiSubmittal ), REMOVEFILTERS ( dim_Date ), fct_RfiSubmittal[ItemType] = "RFI" )
			RETURN IF ( [Is Dashboard Project] && Any > 0, COALESCE ( COUNTROWS (
			FILTER ( CALCULATETABLE ( fct_RfiSubmittal, REMOVEFILTERS ( dim_Date ) ),
			fct_RfiSubmittal[ItemType] = "RFI" && fct_RfiSubmittal[IsOpen]
			&& ( fct_RfiSubmittal[IsPastDue] || ( ISBLANK ( fct_RfiSubmittal[DueDate] ) && fct_RfiSubmittal[DaysOpen] > 7 ) ) ) ), 0 ) )
		formatString: "#,0"
		displayFolder: 22 Dashboard - schedule & site drivers

	/// Replaces Scorecard.xlsx Safety Inspections - performed in the report week
	measure 'Safety Inspections (Week)' =
			VAR E = [Report Window End]
			VAR S = [Report Week End] - 6
			RETURN IF ( [Is Dashboard Project], COALESCE ( CALCULATE ( COUNTROWS ( fct_Inspection ),
			fct_Inspection[Category] = "Safety", fct_Inspection[IsPerformed] = TRUE (),
			fct_Inspection[InspectionDate] >= S, fct_Inspection[InspectionDate] <= E ), 0 ) )
		formatString: "#,0"
		displayFolder: 22 Dashboard - schedule & site drivers

	/// Replaces Scorecard.xlsx Quality Inspections - performed in the report week
	measure 'Quality Inspections (Week)' =
			VAR E = [Report Window End]
			VAR S = [Report Week End] - 6
			RETURN IF ( [Is Dashboard Project], COALESCE ( CALCULATE ( COUNTROWS ( fct_Inspection ),
			fct_Inspection[Category] = "Quality", fct_Inspection[IsPerformed] = TRUE (),
			fct_Inspection[InspectionDate] >= S, fct_Inspection[InspectionDate] <= E ), 0 ) )
		formatString: "#,0"
		displayFolder: 22 Dashboard - schedule & site drivers

	/// Replaces data check - templates no seed_InspectionCategory pattern matches
	measure 'Unclassified Inspections' = COALESCE ( CALCULATE ( COUNTROWS ( fct_Inspection ), fct_Inspection[Category] = "Unclassified" ), 0 )
		formatString: "#,0"
		displayFolder: 22 Dashboard - schedule & site drivers

	/// Replaces Scorecard.xlsx Cash Position - fct_MetricScore (dim_DashBand)
	measure 'Metric Score - Cash Position' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_MetricScore[Score] ),
			fct_MetricScore[MetricKey] = 101, fct_MetricScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx Profitability - fct_MetricScore (dim_DashBand)
	measure 'Metric Score - Profitability' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_MetricScore[Score] ),
			fct_MetricScore[MetricKey] = 102, fct_MetricScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx Aging Balance - fct_MetricScore (dim_DashBand)
	measure 'Metric Score - Aging Balance' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_MetricScore[Score] ),
			fct_MetricScore[MetricKey] = 103, fct_MetricScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx OAC Meeting - fct_MetricScore (dim_DashBand)
	measure 'Metric Score - OAC Meeting' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_MetricScore[Score] ),
			fct_MetricScore[MetricKey] = 201, fct_MetricScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx Trade Partner Meeting - fct_MetricScore (dim_DashBand)
	measure 'Metric Score - Trade Partner Meeting' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_MetricScore[Score] ),
			fct_MetricScore[MetricKey] = 202, fct_MetricScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx 3-Week Look-Ahead - fct_MetricScore (dim_DashBand)
	measure 'Metric Score - 3-Week Look-Ahead' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_MetricScore[Score] ),
			fct_MetricScore[MetricKey] = 203, fct_MetricScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx Monthly Schedule Update - fct_MetricScore (dim_DashBand)
	measure 'Metric Score - Monthly Schedule Update' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_MetricScore[Score] ),
			fct_MetricScore[MetricKey] = 204, fct_MetricScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx Completion Variance - fct_MetricScore (dim_DashBand)
	measure 'Metric Score - Completion Variance' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_MetricScore[Score] ),
			fct_MetricScore[MetricKey] = 205, fct_MetricScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx Submittals - fct_MetricScore (dim_DashBand)
	measure 'Metric Score - Submittals' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_MetricScore[Score] ),
			fct_MetricScore[MetricKey] = 206, fct_MetricScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx RFIs - fct_MetricScore (dim_DashBand)
	measure 'Metric Score - RFIs' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_MetricScore[Score] ),
			fct_MetricScore[MetricKey] = 207, fct_MetricScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx Safety Inspections - fct_MetricScore (dim_DashBand)
	measure 'Metric Score - Safety Inspections' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_MetricScore[Score] ),
			fct_MetricScore[MetricKey] = 301, fct_MetricScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx Quality Inspections - fct_MetricScore (dim_DashBand)
	measure 'Metric Score - Quality Inspections' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_MetricScore[Score] ),
			fct_MetricScore[MetricKey] = 401, fct_MetricScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces derived - the score of the dim_DashMetric row in context
	measure 'Metric Score' =
			VAR K = SELECTEDVALUE ( dim_DashMetric[MetricKey] )
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project] && NOT ISBLANK ( K ), CALCULATE ( MAX ( fct_MetricScore[Score] ),
			fct_MetricScore[MetricKey] = K, fct_MetricScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces derived - the number the row's band scores
	measure 'Metric Driver' =
			VAR K = SELECTEDVALUE ( dim_DashMetric[MetricKey] )
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project] && NOT ISBLANK ( K ), CALCULATE ( MAX ( fct_MetricScore[Driver] ),
			fct_MetricScore[MetricKey] = K, fct_MetricScore[WeeksAgo] = W ) )
		formatString: "0.00"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces derived - the driver, in words
	measure 'Metric Reading' =
			VAR K = SELECTEDVALUE ( dim_DashMetric[MetricKey] )
			VAR V = [Metric Driver]
			RETURN IF ( NOT ISBLANK ( V ), SWITCH ( K,
			101, FORMAT ( V, "0%" ) & " collected vs paid (" & VAR X = [Cash Position] RETURN IF ( ISBLANK ( X ), BLANK (), SWITCH ( TRUE (),     ABS ( X ) >= 1000000, FORMAT ( X / 1000000, "$#,0.0" ) & "M",     ABS ( X ) >= 1000, FORMAT ( X / 1000, "$#,0" ) & "K",     FORMAT ( X, "$#,0" ) ) ) & ")",
			102, FORMAT ( [Projected Gross Margin %], "0.0%" ) & " projected margin, " & FORMAT ( V * 100, "+0.0;-0.0;0.0" ) & " pts vs target",
			103, FORMAT ( V, "0" ) & " days average age of unpaid AR",
			201, ( 4 - V ) & " of 4 weeks met the standard",
			202, ( 4 - V ) & " of 4 weeks met the standard",
			203, IF ( V >= 999, "No look-ahead tasks in Outbuild", "Last worked " & V & " days ago" ),
			204, "Last edited " & V & " days ago",
			205, FORMAT ( [Completion Variance Days], "0;-0;0" ) & " days vs baseline (" & FORMAT ( V, "0%" ) & " of duration)",
			206, V & " overdue",
			207, V & " outstanding",
			301, V & " performed (target 5)",
			401, V & " performed (target 5)",
			208, V & " weekday(s) with no daily log" ) )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces derived - the Scorecard.xlsx band the reading fell in
	measure 'Metric Band' =
			VAR K = SELECTEDVALUE ( dim_DashMetric[MetricKey] )
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project] && NOT ISBLANK ( K ), CALCULATE ( MAX ( fct_MetricScore[BandLabel] ),
			fct_MetricScore[MetricKey] = K, fct_MetricScore[WeeksAgo] = W ) )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces derived - band, or why the measure is not scored
	measure 'Metric State' =
			VAR St = SELECTEDVALUE ( dim_DashMetric[Status] )
			VAR Stg = SELECTEDVALUE ( dim_DashMetric[Stages] )
			VAR Ph = [Project Phase]
			RETURN SWITCH ( TRUE (),
			St = "Proposed", "Proposed - not in the grade until Affect agrees it",
			St <> "Live", "Coming soon",
			NOT ISBLANK ( [Metric Score] ), [Metric Band],
			Stg <> "All" && ( ISBLANK ( Ph ) || NOT CONTAINSSTRING ( Stg, Ph ) ),
			"Not scored at " & COALESCE ( Ph, "unknown" ) & " phase",
			"Not measured - no data" )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces derived - share of the grade this measure carries
	measure 'Metric Weight In Grade' =
			VAR P = SELECTEDVALUE ( dim_DashMetric[PillarKey] )
			VAR W = [Report Weeks Ago]
			VAR N = CALCULATE ( COUNTROWS ( fct_MetricScore ), fct_MetricScore[PillarKey] = P,
			fct_MetricScore[WeeksAgo] = W, NOT ISBLANK ( fct_MetricScore[Score] ) )
			VAR Wt = CALCULATE ( MAX ( dim_DashPillar[Weight] ), REMOVEFILTERS ( dim_DashPillar ), dim_DashPillar[PillarKey] = P )
			RETURN IF ( NOT ISBLANK ( [Metric Score] ) && NOT ISBLANK ( [Grade] ) && N > 0, DIVIDE ( DIVIDE ( Wt, N ), [Grade Coverage %] ) )
		formatString: "0.0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Oct 21 call: a measure below 80% is a top risk
	measure 'Is Top Risk' =
			VAR S = [Metric Score]
			RETURN IF ( NOT ISBLANK ( S ) && S < CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "risk_metric_below" ), "Yes" )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces derived - HIGH below 50% (proposed), MED below 80%
	measure 'Risk Severity' =
			VAR S = [Metric Score]
			RETURN IF ( NOT ISBLANK ( S ) && S < CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "risk_metric_below" ),
			IF ( S < CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "risk_high_below" ), "HIGH", "MED" ) )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 3 pill fills
	measure 'Risk Severity Colour' = IF ( [Risk Severity] = "HIGH", "#F6DADA", IF ( [Risk Severity] = "MED", "#FFF0CF" ) )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 3 pill text
	measure 'Risk Severity Ink' = IF ( [Risk Severity] = "HIGH", "#BF534E", IF ( [Risk Severity] = "MED", "#986319" ) )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Oct 21 call: the grade, and how many things the project failed
	measure 'Measures Below Target' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_ProjectScore[MeasuresBelowTarget] ),
			fct_ProjectScore[WeeksAgo] = W ) )
		formatString: "0"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 3 EXECUTIVE FOCUS - the three weakest measures
	measure 'Executive Focus' =
			VAR W = [Report Weeks Ago]
			VAR T = ADDCOLUMNS ( ALL ( dim_DashMetric ), "@S", VAR K = dim_DashMetric[MetricKey]
			RETURN CALCULATE ( MAX ( fct_MetricScore[Score] ), fct_MetricScore[MetricKey] = K, fct_MetricScore[WeeksAgo] = W ) )
			VAR R = TOPN ( 3, FILTER ( T, NOT ISBLANK ( [@S] ) && [@S] < CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "risk_metric_below" ) ), [@S], ASC, dim_DashMetric[MetricKey], ASC )
			RETURN IF ( [Is Dashboard Project], "EXECUTIVE FOCUS:  " & IF ( ISEMPTY ( R ), "Every measured standard is on target",
			CONCATENATEX ( R, dim_DashMetric[Metric], "  " & UNICHAR ( 8226 ) & "  ", [@S], ASC ) ) )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx Schedule - equal-weighted average of its measured metrics (fct_ProjectScore)
	measure 'Schedule Pillar' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_ProjectScore[SchedulePillar] ),
			fct_ProjectScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx Budget - equal-weighted average of its measured metrics (fct_ProjectScore)
	measure 'Budget Pillar' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_ProjectScore[BudgetPillar] ),
			fct_ProjectScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx Safety - equal-weighted average of its measured metrics (fct_ProjectScore)
	measure 'Safety Pillar' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_ProjectScore[SafetyPillar] ),
			fct_ProjectScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces Scorecard.xlsx Quality - equal-weighted average of its measured metrics (fct_ProjectScore)
	measure 'Quality Pillar' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_ProjectScore[QualityPillar] ),
			fct_ProjectScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces derived - share of the pillar weight that is measured
	measure 'Grade Coverage %' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_ProjectScore[GradeCoverage] ),
			fct_ProjectScore[WeeksAgo] = W ) )
		formatString: "0%"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 GRADE - schedule 50, budget 30, safety 15, quality 5 (Oct 21 call); fct_ProjectScore
	measure 'Grade' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_ProjectScore[Grade] ),
			fct_ProjectScore[WeeksAgo] = W ) )
		formatString: "0"
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2: On track / Monitor / Needs attention / Unscored
	measure 'Grade Status' =
			VAR G = [Grade]
			RETURN IF ( [Is Dashboard Project], SWITCH ( TRUE (), ISBLANK ( G ), "Unscored",
			G >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ), "On track",
			G >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ), "Monitor", "Needs attention" ) )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 grade pill
	measure 'Grade Colour' =
			VAR S = [Grade]
			RETURN SWITCH ( TRUE (), ISBLANK ( S ), "#DDE4EB",
			S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ) / 100 * 100, "#278367",
			S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ) / 100 * 100, "#E5A13B",
			"#BF534E" )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 grade pill text
	measure 'Grade Ink' =
			VAR S = [Grade]
			RETURN IF ( NOT ISBLANK ( S ) && ( S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ) / 100 * 100 || S < CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ) / 100 * 100 ), "#FFFFFF", "#16283F" )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 GRADE cell
	measure 'Grade Cell' =
			VAR G = [Grade]
			RETURN IF ( [Is Dashboard Project], IF ( ISBLANK ( G ), UNICHAR ( 8212 ), FORMAT ( G, "0" ) ) )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces derived - the pillar costing the grade most
	measure 'Weakest Pillar' =
			VAR W = [Report Weeks Ago]
			RETURN IF ( [Is Dashboard Project], CALCULATE ( MAX ( fct_ProjectScore[WeakestPillar] ),
			fct_ProjectScore[WeeksAgo] = W ) )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 SCHEDULE cell - headline reading and pillar score
	measure 'Schedule Cell' =
			VAR D = [Completion Variance Days]
			VAR H = IF ( NOT ISBLANK ( D ), FORMAT ( -D, "+0;-0;0" ) & " days" )
			VAR S = [Schedule Pillar]
			RETURN IF ( [Is Dashboard Project], SWITCH ( TRUE (),
			ISBLANK ( S ), COALESCE ( H, UNICHAR ( 8212 ) ),
			ISBLANK ( H ), FORMAT ( S, "0%" ),
			H & "  " & UNICHAR ( 183 ) & "  " & FORMAT ( S, "0%" ) ) )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 SCHEDULE pill
	measure 'Schedule Colour' =
			VAR S = [Schedule Pillar]
			RETURN SWITCH ( TRUE (), ISBLANK ( S ), "#DDE4EB",
			S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ) / 100 * 1, "#278367",
			S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ) / 100 * 1, "#E5A13B",
			"#BF534E" )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 SCHEDULE pill text
	measure 'Schedule Ink' =
			VAR S = [Schedule Pillar]
			RETURN IF ( NOT ISBLANK ( S ) && ( S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ) / 100 * 1 || S < CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ) / 100 * 1 ), "#FFFFFF", "#16283F" )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 BUDGET cell - headline reading and pillar score
	measure 'Budget Cell' =
			VAR M = [Margin vs Target]
			VAR H = IF ( NOT ISBLANK ( M ), FORMAT ( [Projected Gross Margin %], "0.0%" ) & " GM" )
			VAR S = [Budget Pillar]
			RETURN IF ( [Is Dashboard Project], SWITCH ( TRUE (),
			ISBLANK ( S ), COALESCE ( H, UNICHAR ( 8212 ) ),
			ISBLANK ( H ), FORMAT ( S, "0%" ),
			H & "  " & UNICHAR ( 183 ) & "  " & FORMAT ( S, "0%" ) ) )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 BUDGET pill
	measure 'Budget Colour' =
			VAR S = [Budget Pillar]
			RETURN SWITCH ( TRUE (), ISBLANK ( S ), "#DDE4EB",
			S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ) / 100 * 1, "#278367",
			S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ) / 100 * 1, "#E5A13B",
			"#BF534E" )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 BUDGET pill text
	measure 'Budget Ink' =
			VAR S = [Budget Pillar]
			RETURN IF ( NOT ISBLANK ( S ) && ( S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ) / 100 * 1 || S < CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ) / 100 * 1 ), "#FFFFFF", "#16283F" )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 SAFETY cell - headline reading and pillar score
	measure 'Safety Cell' =
			VAR H = IF ( [Project Phase] = "Construction", [Safety Inspections (Week)] & " insp" )
			VAR S = [Safety Pillar]
			RETURN IF ( [Is Dashboard Project], SWITCH ( TRUE (),
			ISBLANK ( S ), COALESCE ( H, UNICHAR ( 8212 ) ),
			ISBLANK ( H ), FORMAT ( S, "0%" ),
			H & "  " & UNICHAR ( 183 ) & "  " & FORMAT ( S, "0%" ) ) )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 SAFETY pill
	measure 'Safety Colour' =
			VAR S = [Safety Pillar]
			RETURN SWITCH ( TRUE (), ISBLANK ( S ), "#DDE4EB",
			S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ) / 100 * 1, "#278367",
			S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ) / 100 * 1, "#E5A13B",
			"#BF534E" )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 SAFETY pill text
	measure 'Safety Ink' =
			VAR S = [Safety Pillar]
			RETURN IF ( NOT ISBLANK ( S ) && ( S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ) / 100 * 1 || S < CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ) / 100 * 1 ), "#FFFFFF", "#16283F" )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 QUALITY cell - headline reading and pillar score
	measure 'Quality Cell' =
			VAR H = IF ( [Project Phase] = "Construction", [Quality Inspections (Week)] & " insp" )
			VAR S = [Quality Pillar]
			RETURN IF ( [Is Dashboard Project], SWITCH ( TRUE (),
			ISBLANK ( S ), COALESCE ( H, UNICHAR ( 8212 ) ),
			ISBLANK ( H ), FORMAT ( S, "0%" ),
			H & "  " & UNICHAR ( 183 ) & "  " & FORMAT ( S, "0%" ) ) )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 QUALITY pill
	measure 'Quality Colour' =
			VAR S = [Quality Pillar]
			RETURN SWITCH ( TRUE (), ISBLANK ( S ), "#DDE4EB",
			S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ) / 100 * 1, "#278367",
			S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ) / 100 * 1, "#E5A13B",
			"#BF534E" )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 QUALITY pill text
	measure 'Quality Ink' =
			VAR S = [Quality Pillar]
			RETURN IF ( NOT ISBLANK ( S ) && ( S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ) / 100 * 1 || S < CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ) / 100 * 1 ), "#FFFFFF", "#16283F" )
		displayFolder: 23 Dashboard - scorecard

	/// Replaces deck slide 2 TEAM - initials of PM, APM, Super, Asst Super from Procore
	measure 'Team Initials' =
			VAR T = SUMMARIZE ( FILTER ( fct_ProjectTeam, fct_ProjectTeam[RoleOrder] <= 4 ),
			fct_ProjectTeam[RoleOrder], fct_ProjectTeam[MemberName] )
			VAR I = ADDCOLUMNS ( T, "@i",
			VAR Raw = fct_ProjectTeam[MemberName]
			VAR Cut = SEARCH ( " (", Raw, 1, 0 )
			VAR N = TRIM ( IF ( Cut > 0, LEFT ( Raw, Cut - 1 ), Raw ) )
			VAR Sp = LEN ( N ) - LEN ( SUBSTITUTE ( N, " ", "" ) )
			VAR LastWord = IF ( Sp = 0, "", MID ( N, FIND ( "~", SUBSTITUTE ( N, " ", "~", Sp ) ) + 1, 1 ) )
			RETURN UPPER ( LEFT ( N, 1 ) & LastWord ) )
			RETURN IF ( [Is Dashboard Project], COALESCE ( CONCATENATEX ( I, [@i], " " & UNICHAR ( 183 ) & " ", fct_ProjectTeam[RoleOrder], ASC, fct_ProjectTeam[MemberName], ASC ), UNICHAR ( 8212 ) ) )
		displayFolder: 24 Dashboard - project page

	/// Replaces Oct 21 call: the one accountable name
	measure 'Project Executive' = CONCATENATEX ( FILTER ( fct_ProjectTeam, fct_ProjectTeam[RoleCode] = "PX" ), VAR Cut = SEARCH ( " (", fct_ProjectTeam[MemberName], 1, 0 ) RETURN IF ( Cut > 0, LEFT ( fct_ProjectTeam[MemberName], Cut - 1 ), fct_ProjectTeam[MemberName] ), ", ", fct_ProjectTeam[MemberName], ASC )
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 2 TEAM, in full
	measure 'Project Team' =
			VAR T = CONCATENATEX ( FILTER ( fct_ProjectTeam, fct_ProjectTeam[RoleOrder] <= 4 ),
			fct_ProjectTeam[RoleCode] & " " & ( VAR Cut = SEARCH ( " (", fct_ProjectTeam[MemberName], 1, 0 ) RETURN IF ( Cut > 0, LEFT ( fct_ProjectTeam[MemberName], Cut - 1 ), fct_ProjectTeam[MemberName] ) ), "   ", fct_ProjectTeam[RoleOrder], ASC, fct_ProjectTeam[MemberName], ASC )
			VAR X = [Project Executive]
			VAR A = IF ( NOT ISBLANK ( X ), "PX " & X & IF ( NOT ISBLANK ( T ), "   " ) ) & T
			RETURN IF ( [Is Dashboard Project], IF ( A = "", "No PX / PM / Super roles set in Procore", A ) )
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 CURRENT CONTRACT sub-line
	measure 'Contract Change Text' =
			VAR D = [Current Contract] - [Original Contract]
			VAR A = ABS ( D )
			VAR T = SWITCH ( TRUE (), A >= 1000000, FORMAT ( A / 1000000, "$#,0.0" ) & "M",
			A >= 1000, FORMAT ( A / 1000, "$#,0" ) & "K", FORMAT ( A, "$#,0" ) )
			RETURN IF ( NOT ISBLANK ( [Original Contract] ), IF ( D >= 0, "+", "-" ) & T & " vs original" )
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 PROJECT COMPLETE - Outbuild, duration-weighted
	measure 'Work Progress %' =
			VAR T = FILTER ( fct_ScheduleActivity, NOT fct_ScheduleActivity[IsSummary] && fct_ScheduleActivity[DurationDays] > 0 )
			RETURN DIVIDE ( SUMX ( T, fct_ScheduleActivity[DurationDays] * COALESCE ( fct_ScheduleActivity[PercentComplete], 0 ) ),
			SUMX ( T, fct_ScheduleActivity[DurationDays] ) )
		formatString: "0%"
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 TRACKING FINISH - the baseline finish
	measure 'Tracking Finish' = CALCULATE ( MAX ( fct_Milestone[BaselineFinish] ), REMOVEFILTERS ( dim_Date ) )
		formatString: "mmm d, yyyy"
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 ACTUAL FINISH FORECAST - the current critical-path finish
	measure 'Forecast Finish' = [Scheduled Finish]
		formatString: "mmm d, yyyy"
		displayFolder: 24 Dashboard - project page

	/// Replaces card text for Work Progress %
	measure 'Work Progress Shown' = IF ( [Is Dashboard Project], VAR V = [Work Progress %] RETURN IF ( ISBLANK ( V ), "No schedule", FORMAT ( V, "0%" ) ) )
		displayFolder: 24 Dashboard - project page

	/// Replaces card text for Tracking Finish
	measure 'Tracking Finish Shown' = IF ( [Is Dashboard Project], VAR V = [Tracking Finish] RETURN IF ( ISBLANK ( V ), "No baseline", FORMAT ( V, "mmm d, yyyy" ) ) )
		displayFolder: 24 Dashboard - project page

	/// Replaces card text for Forecast Finish
	measure 'Forecast Finish Shown' = IF ( [Is Dashboard Project], VAR V = [Forecast Finish] RETURN IF ( ISBLANK ( V ), "No forecast", FORMAT ( V, "mmm d, yyyy" ) ) )
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 SCHEDULE tile
	measure 'Schedule Headline' =
			VAR D = [Completion Variance Days]
			RETURN SWITCH ( TRUE (), ISBLANK ( D ), "No baseline",
			D = 0, "On baseline", ABS ( D ) & IF ( ABS ( D ) = 1, " DAY", " DAYS" ) )
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 SCHEDULE sub-line
	measure 'Schedule Subline' =
			VAR D = [Completion Variance Days]
			RETURN SWITCH ( TRUE (), ISBLANK ( D ), "Outbuild baseline needed", D > 0, "Past tracking finish",
			D < 0, "Ahead of tracking finish", "Forecast = tracking finish" )
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 tile accent
	measure 'Schedule Tile Colour' =
			VAR D = [Completion Variance Days]
			RETURN SWITCH ( TRUE (), ISBLANK ( D ), "#DDE4EB", D <= 0, "#278367", D <= 7, "#E5A13B", "#BF534E" )
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 PROJECT SCORECARD tile
	measure 'Grade Text' =
			VAR G = [Grade]
			RETURN IF ( ISBLANK ( G ), "Unscored", FORMAT ( G / 100, "0%" ) )
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 PROJECT SCORECARD sub-line
	measure 'Grade Subline' =
			IF ( ISBLANK ( [Grade] ), "Under " & FORMAT ( CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "min_coverage" ), "0%" ) & " of the weight measured",
			[Grade Status] & "  " & UNICHAR ( 183 ) & "  " & [Measures Below Target] & " below target" )
		displayFolder: 24 Dashboard - project page

	/// Replaces derived - billed % less Outbuild work progress %, in points
	measure 'Billing Ahead Of Work Pts' =
			VAR B = [Billed % Of Contract]
			VAR P = [Work Progress %]
			RETURN IF ( NOT ISBLANK ( B ) && NOT ISBLANK ( P ), ( B - P ) * 100 )
		formatString: "+0;-0;0"
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 BILLED TO DATE sub-line, with the billing-vs-progress gap
	measure 'Billed Subline' =
			VAR G = [Billing Ahead Of Work Pts]
			RETURN FORMAT ( [Billed % Of Contract], "0.0%" ) & " of contract" & SWITCH ( TRUE (),
			ISBLANK ( G ), "",
			G >= 1, "  " & UNICHAR ( 8226 ) & "  billed " & FORMAT ( G, "0" ) & " pts ahead of work",
			G <= -1, "  " & UNICHAR ( 8226 ) & "  work " & FORMAT ( -G, "0" ) & " pts ahead of billing",
			"  " & UNICHAR ( 8226 ) & "  in line with work" )
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 PAID TO DATE - Sage receipts
	measure 'Paid To Date' = SUM ( fct_ProjectPosition[PaidToDate] )
		formatString: "$#,0"
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 REMAINING CONTRACT BALANCE
	measure 'Remaining Contract Balance' =
			VAR C = [Position Contract]
			RETURN IF ( NOT ISBLANK ( C ), C - [Billed To Date (Gross)] )
		formatString: "$#,0"
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 cash / forecasting exceptions
	measure 'Financial Exceptions' =
			VAR CP = [Cash Position]
			VAR Aged = CALCULATE ( [AR Over 60 Days], fct_Invoice[HasUnmatchedProject] <> TRUE () )
			VAR FV = [Forecast Variance]
			VAR L = FILTER ( {
			( 1, IF ( CP < 0, "Cash negative: " & FORMAT ( CP, "$#,0" ) ) ),
			( 2, IF ( Aged > 0, FORMAT ( Aged, "$#,0" ) & " of AR over 60 days" ) ),
			( 3, IF ( FV < 0, "Forecast over budget by " & FORMAT ( -FV, "$#,0" ) ) ),
			( 4, IF ( [Margin vs Target] < 0, "Projected margin below target" ) ) }, NOT ISBLANK ( [Value2] ) )
			RETURN IF ( [Is Dashboard Project], IF ( ISEMPTY ( L ), "No cash or forecasting exceptions",
			CONCATENATEX ( L, [Value2], "  " & UNICHAR ( 8226 ) & "  ", [Value1], ASC ) ) )
		displayFolder: 24 Dashboard - project page

	/// Replaces derived - divisions 01-44 of the new cost-code master
	measure 'Subcontract Budget' =
			CALCULATE ( SUM ( fct_BudgetLine[BudgetAmount] ), REMOVEFILTERS ( dim_Date ),
			FILTER ( ALL ( dim_CostCodeCrosswalk[NewDivisionCode] ), COALESCE ( dim_CostCodeCrosswalk[NewDivisionCode], "00" ) < "45" ) )
		formatString: "$#,0"
		displayFolder: 24 Dashboard - project page

	/// Replaces derived
	measure 'Subcontract Committed' =
			CALCULATE ( SUM ( fct_BudgetLine[CommittedAmount] ), REMOVEFILTERS ( dim_Date ),
			FILTER ( ALL ( dim_CostCodeCrosswalk[NewDivisionCode] ), COALESCE ( dim_CostCodeCrosswalk[NewDivisionCode], "00" ) < "45" ) )
		formatString: "$#,0"
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 1 SUBCONTRACTOR COVERAGE / slide 3 RISK BOUGHT OUT - committed over buyable budget
	measure 'Subcontractor Coverage %' = DIVIDE ( [Subcontract Committed], [Subcontract Budget] )
		formatString: "0%"
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 NEAR-TERM MILESTONES [Next 3 Weeks]
	measure 'Near Term Flag' =
			VAR A = [Data As Of]
			VAR Z = A + CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "lookahead_days" )
			VAR S = SELECTEDVALUE ( fct_ScheduleActivity[StartDate] )
			VAR F = SELECTEDVALUE ( fct_ScheduleActivity[FinishDate] )
			RETURN IF ( HASONEVALUE ( fct_ScheduleActivity[ActivityKey] )
			&& NOT SELECTEDVALUE ( fct_ScheduleActivity[IsSummary] ) && NOT SELECTEDVALUE ( fct_ScheduleActivity[IsComplete] )
			&& ( ( S >= A && S <= Z ) || ( F >= A && F <= Z ) ), "Yes" )
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 CRITICAL PATH [Next 3 Weeks]
	measure 'Critical Near Term Flag' = IF ( [Near Term Flag] = "Yes" && SELECTEDVALUE ( fct_ScheduleActivity[IsCritical] ), "Yes" )
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 milestone sub-line
	measure 'Activity Next Step' =
			VAR A = [Data As Of]
			VAR S = SELECTEDVALUE ( fct_ScheduleActivity[StartDate] )
			VAR F = SELECTEDVALUE ( fct_ScheduleActivity[FinishDate] )
			RETURN IF ( HASONEVALUE ( fct_ScheduleActivity[ActivityKey] ),
			IF ( S > A, "Starts " & FORMAT ( S, "mmm d" ), "Finish " & FORMAT ( F, "mmm d" ) )
			& IF ( SELECTEDVALUE ( fct_ScheduleActivity[FinishVarianceDays] ) > 0,
			"  " & UNICHAR ( 183 ) & "  " & SELECTEDVALUE ( fct_ScheduleActivity[FinishVarianceDays] ) & " days behind baseline" ) )
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 schedule pressure / critical path
	measure 'Behind Schedule Flag' =
			IF ( HASONEVALUE ( fct_ScheduleActivity[ActivityKey] ) && NOT SELECTEDVALUE ( fct_ScheduleActivity[IsSummary] )
			&& NOT SELECTEDVALUE ( fct_ScheduleActivity[IsComplete] ) && SELECTEDVALUE ( fct_ScheduleActivity[FinishVarianceDays] ) > 0, "Yes" )
		displayFolder: 24 Dashboard - project page

	/// Replaces derived
	measure 'Days Behind Baseline' = MAX ( fct_ScheduleActivity[FinishVarianceDays] )
		formatString: "0"
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 RECENT WINS - completed in the report week
	measure 'Recent Win Flag' =
			VAR E = [Report Window End]
			VAR S = [Report Week End] - 6
			VAR F = SELECTEDVALUE ( fct_ScheduleActivity[FinishDate] )
			RETURN IF ( HASONEVALUE ( fct_ScheduleActivity[ActivityKey] ) && SELECTEDVALUE ( fct_ScheduleActivity[IsComplete] )
			&& NOT SELECTEDVALUE ( fct_ScheduleActivity[IsSummary] ) && F >= S && F <= E, "Yes" )
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 3 SAFETY / QUALITY lists - performed in the report week
	measure 'Inspection In Week Flag' =
			VAR E = [Report Window End]
			VAR S = [Report Week End] - 6
			VAR D = SELECTEDVALUE ( fct_Inspection[InspectionDate] )
			RETURN IF ( HASONEVALUE ( fct_Inspection[InspectionKey] ) && SELECTEDVALUE ( fct_Inspection[IsPerformed] )
			&& D >= S && D <= E, "Yes" )
		displayFolder: 24 Dashboard - project page

	/// Replaces deck slide 1 REVENUE YTD - Sage AR invoiced this calendar year, every job
	measure 'Revenue YTD' =
			VAR A = [Data As Of]
			RETURN CALCULATE ( SUM ( fct_Invoice[Amount] ), REMOVEFILTERS ( dim_Date ), REMOVEFILTERS ( dim_Project ),
			fct_Invoice[SentDate] >= DATE ( YEAR ( A ), 1, 1 ), fct_Invoice[SentDate] <= A )
		formatString: "$#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 REVENUE - ACTUAL, by month
	measure 'Revenue Last 6 Months' =
			VAR A = [Data As Of]
			VAR M = MAX ( dim_Date[Date] )
			RETURN IF ( M > EOMONTH ( A, -6 ) && MIN ( dim_Date[Date] ) <= A,
			CALCULATE ( SUM ( fct_Invoice[Amount] ), REMOVEFILTERS ( dim_Project ) ) )
		formatString: "$#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 ACTIVE PROJECTS
	measure 'Active Projects' =
			COALESCE ( COUNTROWS ( FILTER ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			TRUE () ) ), 0 )
		formatString: "#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 2 ON TRACK
	measure 'Projects On Track' =
			COALESCE ( COUNTROWS ( FILTER ( ADDCOLUMNS ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ), "@g", [Grade] ),
			[@g] >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ) ) ), 0 )
		formatString: "#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 2 MONITOR
	measure 'Projects Monitor' =
			COALESCE ( COUNTROWS ( FILTER ( ADDCOLUMNS ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ), "@g", [Grade] ),
			[@g] >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ) && [@g] < CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ) ) ), 0 )
		formatString: "#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 2 NEEDS ATTENTION / slide 1 'require attention'
	measure 'Projects Needing Attention' =
			COALESCE ( COUNTROWS ( FILTER ( ADDCOLUMNS ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ), "@g", [Grade] ),
			NOT ISBLANK ( [@g] ) && [@g] < CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ) ) ), 0 )
		formatString: "#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 2 UNSCORED
	measure 'Projects Unscored' =
			COALESCE ( COUNTROWS ( FILTER ( ADDCOLUMNS ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ), "@g", [Grade] ),
			ISBLANK ( [@g] ) ) ), 0 )
		formatString: "#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 PROJECTS AT RISK - grade 45 and below (Oct 21 call)
	measure 'Projects At Risk (Grade)' =
			COALESCE ( COUNTROWS ( FILTER ( ADDCOLUMNS ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ), "@g", [Grade] ),
			NOT ISBLANK ( [@g] ) && [@g] <= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_at_risk_max" ) ) ), 0 )
		formatString: "#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 'Schedule (2) - Margin (1)' - weakest pillar of each at-risk project
	measure 'At Risk Breakdown' =
			VAR G = ADDCOLUMNS ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ), "@g", [Grade] )
			VAR T = ADDCOLUMNS ( FILTER ( G, NOT ISBLANK ( [@g] ) && [@g] <= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_at_risk_max" ) ), "@p", [Weakest Pillar] )
			VAR N = GROUPBY ( T, [@p], "@n", COUNTX ( CURRENTGROUP (), 1 ) )
			RETURN IF ( ISEMPTY ( T ), "None at or below grade " & CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_at_risk_max" ),
			CONCATENATEX ( N, [@p] & " (" & [@n] & ")", "  " & UNICHAR ( 8226 ) & "  ", [@n], DESC, [@p], ASC ) )
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 ACTIVE PROJECTS sub-line
	measure 'Attention Subline' = [Projects Needing Attention] & " require attention"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 GROSS MARGIN - projected, active projects
	measure 'Portfolio Gross Margin %' =
			VAR R = SUMX ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			IF ( NOT ISBLANK ( [Projected Cost] ), [Projected Revenue] ) )
			VAR C = SUMX ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			[Projected Cost] )
			RETURN IF ( R > 0, DIVIDE ( R - C, R ) )
		formatString: "0.0%"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 GROSS MARGIN sub-line
	measure 'Gross Margin Subline' =
			VAR D = [Portfolio Gross Margin %] - [Gross Margin Target]
			RETURN FORMAT ( D * 100, "+0.0;-0.0;0.0" ) & " pts vs " & FORMAT ( [Gross Margin Target], "0.0%" ) & " target"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 BACKLOG - contract not yet billed, active projects
	measure 'Backlog' =
			SUMX ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			MAX ( 0, [Position Contract] - [Billed To Date (Gross)] ) )
		formatString: "$#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 BACKLOG sub-line - at the last 3 months' billing rate
	measure 'Backlog Subline' =
			VAR A = [Data As Of]
			VAR S = EOMONTH ( A, -4 ) + 1
			VAR E = EOMONTH ( A, -1 )
			VAR Rate = DIVIDE ( CALCULATE ( SUM ( fct_Invoice[Amount] ), REMOVEFILTERS ( dim_Date ), REMOVEFILTERS ( dim_Project ),
			fct_Invoice[SentDate] >= S, fct_Invoice[SentDate] <= E ), 3 )
			RETURN IF ( Rate > 0, FORMAT ( DIVIDE ( [Backlog], Rate ), "0.0" ) & " months cover" )
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 CASH POSITION - Chris's formula, active projects
	measure 'Portfolio Cash Position' =
			SUMX ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			[Cash Position] )
		formatString: "$#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 CASH POSITION sub-line
	measure 'Cash Subline' =
			VAR I = SUMX ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			[Cash Collected] )
			VAR O = SUMX ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			[Cash Paid Out] )
			RETURN IF ( O > 0, FORMAT ( DIVIDE ( I, O ), "0%" ) & " collected vs paid" )
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 SAFETY tile - 'Calc based on # of inspections' callout
	measure 'Portfolio Safety Score' =
			VAR T = ADDCOLUMNS ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ), "@s", [Safety Pillar] )
			RETURN AVERAGEX ( FILTER ( T, NOT ISBLANK ( [@s] ) ), [@s] )
		formatString: "0%"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 SAFETY sub-line
	measure 'Safety Subline' =
			VAR N = SUMX ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			[Safety Inspections (Week)] )
			VAR P = COUNTROWS ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" && [Project Phase] = "Construction" ) )
			RETURN COALESCE ( N, 0 ) & " inspections across " & COALESCE ( P, 0 ) & " sites (5 each)"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 ON SCHEDULE - forecast finish on or before baseline
	measure 'Projects On Schedule' =
			COALESCE ( COUNTROWS ( FILTER ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			NOT ISBLANK ( [Completion Variance Days] ) && [Completion Variance Days] <= 0 ) ), 0 )
		formatString: "#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces derived
	measure 'Projects With Baseline' =
			COALESCE ( COUNTROWS ( FILTER ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			NOT ISBLANK ( [Completion Variance Days] ) ) ), 0 )
		formatString: "#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces derived
	measure 'On Schedule Ratio' = DIVIDE ( [Projects On Schedule], [Projects With Baseline] )
		formatString: "0%"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 '19 / 24'
	measure 'On Schedule Text' = [Projects On Schedule] & " / " & [Projects With Baseline]
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 ON BUDGET - forecast final cost within budget
	measure 'Projects On Budget' =
			COALESCE ( COUNTROWS ( FILTER ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			NOT ISBLANK ( [Forecast Variance] ) && [Forecast Variance] >= 0 ) ), 0 )
		formatString: "#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces derived
	measure 'Projects With Budget' =
			COALESCE ( COUNTROWS ( FILTER ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			NOT ISBLANK ( [Forecast Variance] ) ) ), 0 )
		formatString: "#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces derived
	measure 'On Budget Ratio' = DIVIDE ( [Projects On Budget], [Projects With Budget] )
		formatString: "0%"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 '20 / 24'
	measure 'On Budget Text' = [Projects On Budget] & " / " & [Projects With Budget]
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 SUBCONTRACTOR COVERAGE
	measure 'Portfolio Subcontractor Coverage' =
			DIVIDE ( SUMX ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			[Subcontract Committed] ), SUMX ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			[Subcontract Budget] ) )
		formatString: "0%"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 CHANGE ORDERS APPROVED - approved value over approved + pending
	measure 'Change Orders Approved %' =
			VAR Ap = SUMX ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			CALCULATE ( [Approved Change Orders], REMOVEFILTERS ( dim_Date ) ) )
			VAR Pe = SUMX ( FILTER ( VALUES ( dim_Project[ProjectKey] ), [Dashboard Status] = "Active" ),
			[Pending Change Orders] )
			RETURN DIVIDE ( Ap, Ap + Pe )
		formatString: "0%"
		displayFolder: 25 Dashboard - executive

	/// Replaces derived - visual filter for active projects
	measure 'Active Flag' = IF ( [Dashboard Status] = "Active", "Yes" )
		displayFolder: 25 Dashboard - executive

	/// Replaces derived - visual filter for the inactive / archived list
	measure 'Not Active Flag' = IF ( [Is Dashboard Project] && [Dashboard Status] <> "Active", "Yes" )
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 1 PRIORITY PROJECTS - lowest grade first
	measure 'Priority Score' = IF ( [Dashboard Status] = "Active", VAR G = [Grade] RETURN IF ( NOT ISBLANK ( G ), 100 - G ) )
		formatString: "0.0"
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 3 header
	measure 'Project Title' = IF ( HASONEVALUE ( dim_Project[ProjectName] ), UPPER ( VALUES ( dim_Project[ProjectName] ) ), "SELECT A PROJECT" )
		displayFolder: 25 Dashboard - executive

	/// Replaces deck header sub-line
	measure 'Week Header' = "CONSTRUCTION OPERATIONS  |  " & UPPER ( [Report Week Label] )
		displayFolder: 25 Dashboard - executive

	/// Replaces derived - open Sage AR on jobs with no Procore project (dq_DataGap 'Unmatched AR invoice')
	measure 'Unattributed Open AR' = CALCULATE ( SUM ( fct_Invoice[Balance] ), fct_Invoice[HasUnmatchedProject] = TRUE (), REMOVEFILTERS () )
		formatString: "$#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces derived - Sage jobs carrying that AR
	measure 'Unattributed AR Jobs' = CALCULATE ( DISTINCTCOUNT ( fct_Invoice[SageJobNumber] ), fct_Invoice[HasUnmatchedProject] = TRUE (),    fct_Invoice[Balance] > 0, REMOVEFILTERS () )
		formatString: "#,0"
		displayFolder: 25 Dashboard - executive

	/// Replaces derived - the crosswalk gap, in words
	measure 'Data Notice' =
			VAR T = VAR X = [Unattributed Open AR]
			RETURN IF ( ISBLANK ( X ), BLANK (), SWITCH ( TRUE (),
			ABS ( X ) >= 1000000, FORMAT ( X / 1000000, "$#,0.0" ) & "M",
			ABS ( X ) >= 1000, FORMAT ( X / 1000, "$#,0" ) & "K",
			FORMAT ( X, "$#,0" ) ) )
			RETURN IF ( [Unattributed Open AR] > 0, "DATA TO RESOLVE:  " & T & " of open AR is on " & [Unattributed AR Jobs]
			& " Sage jobs with no Procore project, so no project here carries it. Map them in the crosswalk.",
			"Every open AR invoice is matched to a project" )
		displayFolder: 25 Dashboard - executive

	/// Replaces deck header - when the numbers were true
	measure 'Data As Of Header' = "DATA AS OF " & UPPER ( FORMAT ( [Data As Of], "mmm d, yyyy" ) ) & "  " & UNICHAR ( 8226 ) & "  " & [Pipeline Status]
		displayFolder: 25 Dashboard - executive

	/// Replaces deck slide 2 header
	measure 'Portfolio Header' = [Active Projects] & " ACTIVE PROJECTS  " & UNICHAR ( 8226 ) & "  " & UPPER ( [Report Week Label] )
		displayFolder: 25 Dashboard - executive

	/// Replaces grade detail - score pill
	measure 'Metric Colour' =
			VAR S = [Metric Score]
			RETURN SWITCH ( TRUE (), ISBLANK ( S ), "#DDE4EB",
			S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ) / 100 * 1, "#278367",
			S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ) / 100 * 1, "#E5A13B",
			"#BF534E" )
		displayFolder: 25 Dashboard - executive

	/// Replaces grade detail - score pill text
	measure 'Metric Ink' =
			VAR S = [Metric Score]
			RETURN IF ( NOT ISBLANK ( S ) && ( S >= CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_on_track_from" ) / 100 * 1 || S < CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "grade_monitor_from" ) / 100 * 1 ), "#FFFFFF", "#16283F" )
		displayFolder: 25 Dashboard - executive

	/// Replaces grade detail - the meetings the rolling four weeks scored
	measure 'Meeting In Window Flag' =
			VAR E = [Report Week End]
			VAR D = SELECTEDVALUE ( fct_Meeting[MeetingDate] )
			RETURN IF ( HASONEVALUE ( fct_Meeting[MeetingKey] ) && SELECTEDVALUE ( fct_Meeting[MeetingType] ) IN { "OAC", "Trade Partner" }
			&& D >= E - 27 && D <= E, "Yes" )
		displayFolder: 25 Dashboard - executive

	/// Replaces grade detail - did this meeting count
	measure 'Meeting Met Standard' =
			IF ( HASONEVALUE ( fct_Meeting[MeetingKey] ), IF ( SELECTEDVALUE ( fct_Meeting[IsCompliant] ), "Yes",
			IF ( SELECTEDVALUE ( fct_Meeting[IsDuplicateDate] ), "Duplicate of an earlier meeting", "No" ) ) )
		displayFolder: 25 Dashboard - executive

	/// Replaces derived - why a project is off the active list
	measure 'Status Note' =
			VAR S = [Dashboard Status]
			RETURN IF ( S <> "Active", S & IF ( S = "Inactive", " - no Procore activity in " & CALCULATE ( MAX ( dim_DashSetting[Value] ), REMOVEFILTERS ( dim_DashSetting ), dim_DashSetting[SettingKey] = "active_within_days" ) & " days" ) )
		displayFolder: 25 Dashboard - executive

	column _placeholder
		isHidden
		dataType: string
		summarizeBy: none
		sourceColumn: _placeholder

	column _built_at
		isHidden
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		summarizeBy: none
		sourceColumn: _built_at

	partition _Measures = entity
		mode: directLake
		source
			entityName: measures_anchor
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
