	column ProjectName
		dataType: string
		summarizeBy: none
		sourceColumn: ProjectName

	column SageJobNumber
		dataType: string
		summarizeBy: none
		sourceColumn: SageJobNumber

	column SageJobName
		dataType: string
		summarizeBy: none
		sourceColumn: SageJobName

	column MatchRule
		dataType: string
		summarizeBy: none
		sourceColumn: MatchRule

	column IsAmbiguous
