table dim_DashPillar

	column PillarKey
		dataType: int64
		summarizeBy: none
		sourceColumn: PillarKey

	column Pillar
		dataType: string
		summarizeBy: none
		sourceColumn: Pillar

	column Weight
		dataType: double
		summarizeBy: none
		sourceColumn: Weight
		formatString: 0%

	column SortOrder
		dataType: int64
		summarizeBy: sum
		sourceColumn: SortOrder

	column ScorecardDepartment
		dataType: string
		summarizeBy: none
		sourceColumn: ScorecardDepartment

	column Source
		dataType: string
		summarizeBy: none
		sourceColumn: Source

	partition dim_DashPillar = entity
		mode: directLake
		source
			entityName: dim_dashpillar
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
