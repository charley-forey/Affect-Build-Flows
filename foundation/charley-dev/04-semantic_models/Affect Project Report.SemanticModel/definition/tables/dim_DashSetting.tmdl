table dim_DashSetting

	column SettingKey
		dataType: string
		summarizeBy: none
		sourceColumn: SettingKey

	column Value
		dataType: double
		summarizeBy: sum
		sourceColumn: Value

	column Note
		dataType: string
		summarizeBy: none
		sourceColumn: Note

	partition dim_DashSetting = entity
		mode: directLake
		source
			entityName: dim_dashsetting
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
