table dim_ReportWeek

	column WeeksAgo
		dataType: int64
		summarizeBy: sum
		sourceColumn: WeeksAgo

	column WeekStart
		dataType: dateTime
		summarizeBy: none
		sourceColumn: WeekStart
		formatString: mm/dd/yy

	column WeekEnd
		dataType: dateTime
		summarizeBy: none
		sourceColumn: WeekEnd
		formatString: mm/dd/yy

	column WeekLabel
		dataType: string
		summarizeBy: none
		sourceColumn: WeekLabel
		sortByColumn: WeeksAgo

	column WeekSort
		dataType: int64
		summarizeBy: none
		sourceColumn: WeekSort

	column AsOfDate
		dataType: dateTime
		summarizeBy: none
		sourceColumn: AsOfDate
		formatString: mm/dd/yy

	partition dim_ReportWeek = entity
		mode: directLake
		source
			entityName: dim_reportweek
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
