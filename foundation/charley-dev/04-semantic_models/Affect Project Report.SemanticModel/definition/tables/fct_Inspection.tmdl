table fct_Inspection

	column ProjectKey
		dataType: string
		summarizeBy: none
		sourceColumn: ProjectKey

	column InspectionKey
		dataType: string
		summarizeBy: none
		sourceColumn: InspectionKey

	column InspectionNumber
		dataType: string
		summarizeBy: none
		sourceColumn: InspectionNumber

	column InspectionName
		dataType: string
		summarizeBy: none
		sourceColumn: InspectionName

	column TemplateName
		dataType: string
		summarizeBy: none
		sourceColumn: TemplateName

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column StatusLabel
		dataType: string
		summarizeBy: none
		sourceColumn: StatusLabel

	column InspectionDate
		dataType: dateTime
		summarizeBy: none
		sourceColumn: InspectionDate
		formatString: yyyy-mm-dd

	column DueDate
		dataType: dateTime
		summarizeBy: none
		sourceColumn: DueDate
		formatString: yyyy-mm-dd

	column ItemCount
		dataType: int64
		summarizeBy: sum
		sourceColumn: ItemCount

	column DeficientItemCount
		dataType: int64
		summarizeBy: sum
		sourceColumn: DeficientItemCount

	column IsPerformed
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsPerformed

	partition fct_Inspection = entity
		mode: directLake
		source
			entityName: fct_inspection
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
