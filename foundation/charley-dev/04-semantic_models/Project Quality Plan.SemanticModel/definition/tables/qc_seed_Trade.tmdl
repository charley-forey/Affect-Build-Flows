table qc_seed_Trade

	column TradeKey
		dataType: string
		summarizeBy: none
		sourceColumn: TradeKey

	column TradeName
		dataType: string
		summarizeBy: none
		sourceColumn: TradeName

	column SheetName
		dataType: string
		summarizeBy: none
		sourceColumn: SheetName

	column CsiCode
		dataType: string
		summarizeBy: none
		sourceColumn: CsiCode

	column DfowRef
		dataType: string
		summarizeBy: none
		sourceColumn: DfowRef

	column RiskTier
		dataType: int64
		summarizeBy: sum
		sourceColumn: RiskTier

	column SortOrder
		dataType: int64
		summarizeBy: sum
		sourceColumn: SortOrder

	partition qc_seed_Trade = entity
		mode: directLake
		source
			entityName: qc_seed_trade
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
