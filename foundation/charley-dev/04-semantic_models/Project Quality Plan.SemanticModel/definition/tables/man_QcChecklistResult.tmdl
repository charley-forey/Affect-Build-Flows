table man_QcChecklistResult

	column ProjectKey
		dataType: string
		summarizeBy: none
		sourceColumn: ProjectKey

	column TradeKey
		dataType: string
		summarizeBy: none
		sourceColumn: TradeKey

	column ItemKey
		dataType: string
		summarizeBy: none
		sourceColumn: ItemKey

	column StageCode
		dataType: string
		summarizeBy: none
		sourceColumn: StageCode

	column ResultCode
		dataType: string
		summarizeBy: none
		sourceColumn: ResultCode

	column InspectedDate
		dataType: dateTime
		summarizeBy: none
		sourceColumn: InspectedDate
		formatString: yyyy-mm-dd

	column InspectedBy
		dataType: string
		summarizeBy: none
		sourceColumn: InspectedBy

	column Notes
		dataType: string
		summarizeBy: none
		sourceColumn: Notes

	partition man_QcChecklistResult = entity
		mode: directLake
		source
			entityName: man_qcchecklistresult
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
