	column SubmittalKey
		dataType: string
		summarizeBy: none
		sourceColumn: SubmittalKey

	column SubmittalNumber
		dataType: string
		summarizeBy: none
		sourceColumn: SubmittalNumber

	column Subject
		dataType: string
		summarizeBy: none
		sourceColumn: Subject

	column CostCodeKey
		dataType: string
		summarizeBy: none
		sourceColumn: CostCodeKey

	column SourceStatus
		dataType: string
		summarizeBy: none
		sourceColumn: SourceStatus

	column StatusCode
		dataType: string
		summarizeBy: none
		sourceColumn: StatusCode

	column SubmittalTypeCode
		dataType: string
		summarizeBy: none
		sourceColumn: SubmittalTypeCode

	column IsMockup
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsMockup

	column CreatedDate
		dataType: dateTime
		summarizeBy: none
		sourceColumn: CreatedDate
		formatString: yyyy-mm-dd

	column DueDate
		dataType: dateTime
		summarizeBy: none
		sourceColumn: DueDate
		formatString: yyyy-mm-dd

	column RespondedDate
		dataType: dateTime
		summarizeBy: none
		sourceColumn: RespondedDate
		formatString: yyyy-mm-dd

	column MonthStart
		dataType: dateTime
		summarizeBy: none
		sourceColumn: MonthStart
		formatString: yyyy-mm-dd

	column IsOpen
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsOpen

	column TurnaroundDays
		dataType: int64
		summarizeBy: sum
		sourceColumn: TurnaroundDays

	column IsOverdue
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsOverdue

	partition fct_QcSubmittal = entity
		mode: directLake
		source
			entityName: fct_qcsubmittal
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
