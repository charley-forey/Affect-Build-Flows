table _Measures

	/// Replaces nothing - the workbook could not say when it was last true
	measure 'Last Refresh' = MAX('_Measures'[_built_at])
		formatString: "yyyy-mm-dd hh:nn"
		displayFolder: 00 Report context

	/// Replaces the workbook used TODAY(), so a saved copy silently re-dated itself
	measure 'Report Month Label' =
			VAR L = MIN ( dim_Date[MonthStart] )
			VAR H = MAX ( dim_Date[MonthStart] )
			RETURN IF ( NOT ISFILTERED ( dim_Date ), "All months", IF ( L = H, FORMAT ( L, "MMMM YYYY" ), FORMAT ( L, "MMMM YYYY" ) & " - " & FORMAT ( H, "MMMM YYYY" ) ) )
		displayFolder: 00 Report context

	/// Replaces no workbook equivalent - a spreadsheet cannot say when it was last correct
	measure 'Last Checked Run' = MAX ( meta_PipelineRun[RunAt] )
		formatString: "yyyy-mm-dd hh:nn"
		displayFolder: 00 Report context

	/// Replaces derived
	measure 'Hours Since Last Checked Run' =
			VAR Last = MAX ( meta_PipelineRun[RunAt] )
			RETURN IF ( ISBLANK ( Last ), BLANK (), DATEDIFF ( Last, UTCNOW (), HOUR ) )
		formatString: "#,0"
		displayFolder: 00 Report context

	/// Replaces nothing - text not colour, so it survives greyscale and colour-blindness
	measure 'Pipeline Status' =
			VAR Last = MAX ( meta_PipelineRun[RunAt] )
			VAR Built = [Last Refresh]
			VAR Latest = FILTER ( ALL ( meta_PipelineRun ), meta_PipelineRun[RunAt] = Last )
			VAR Blocked = COUNTROWS ( FILTER ( Latest, meta_PipelineRun[Status] <> "ok" || meta_PipelineRun[Blocking] > 0 ) )
			VAR Warnings = SUMX ( Latest, meta_PipelineRun[Failing] )
			VAR Hrs = DATEDIFF ( Last, UTCNOW (), HOUR )
			RETURN SWITCH ( TRUE (),
			ISBLANK ( Last ), "Unknown - no checked run",
			Built > Last, "Unvalidated - data built after last check",
			Blocked > 0, "BLOCKED - validation failed",
			Hrs < 0, "Unknown - check timestamp is in the future",
			Hrs > 72, "STALE - no checked run in over 72 hours",
			Hrs > 30, "Late - no checked run in over 30 hours",
			Warnings > 0, "Gold checked with warnings; source completeness unverified",
			"Gold checks passed; source completeness unverified" )
		displayFolder: 00 Report context

	/// Replaces nothing - the workbook is one project per file
	measure 'Projects With Quality Data' = CALCULATE(DISTINCTCOUNT(fct_QcNcr[ProjectKey]), ALL(dim_Project))
		formatString: "#,0"
		displayFolder: 00 Report context

	/// Replaces NCR Log!B4 (Total Raised)
	measure 'Total Observations' = COUNTROWS(fct_QcNcr)
		formatString: "#,0"
		displayFolder: 01 Non-conformance

	/// Replaces NCR Log!D4 (Open)
	measure 'Open Observations' = CALCULATE(COUNTROWS(fct_QcNcr), fct_QcNcr[IsOpen] = TRUE())
		formatString: "#,0"
		displayFolder: 01 Non-conformance

	/// Replaces NCR Log!F4 (Closed)
	measure 'Closed Observations' = CALCULATE(COUNTROWS(fct_QcNcr), fct_QcNcr[IsOpen] = FALSE())
		formatString: "#,0"
		displayFolder: 01 Non-conformance

	/// Replaces NCR Log!H4 (Overdue)
	measure 'Observations Past Due' = CALCULATE(COUNTROWS(fct_QcNcr), fct_QcNcr[IsPastDue] = TRUE())
		formatString: "#,0"
		displayFolder: 01 Non-conformance

	/// Replaces NCR Log!K4 (Avg Days to Close)
	measure 'Avg Observation Closure Days' = AVERAGEX(FILTER(fct_QcNcr, fct_QcNcr[IsOpen] = FALSE()), fct_QcNcr[DaysOpen])
		formatString: "#,0.0"
		displayFolder: 01 Non-conformance

	/// Replaces NCR Log - not computed in the workbook
	measure 'Observation Closure Rate' = DIVIDE([Closed Observations], [Total Observations])
		formatString: "0.0%"
		displayFolder: 01 Non-conformance

	/// Replaces Punch & RCL Log!B4 (Total Items)
	measure 'Total Punch Items' = COUNTROWS(fct_QcPunch)
		formatString: "#,0"
		displayFolder: 02 Punch & completion

	/// Replaces Punch & RCL Log!D4 (Open)
	measure 'Open Punch Items' = CALCULATE(COUNTROWS(fct_QcPunch), fct_QcPunch[IsOpen] = TRUE())
		formatString: "#,0"
		displayFolder: 02 Punch & completion

	/// Replaces Punch & RCL Log!L4 (Aged > 7 Days)
	measure 'Punch Items Aged Over 7 Days' = CALCULATE(COUNTROWS(fct_QcPunch), fct_QcPunch[IsOpen] = TRUE(), fct_QcPunch[DaysOpen] > 7)
		formatString: "#,0"
		displayFolder: 02 Punch & completion

	/// Replaces Punch & RCL Log!N4 (% Closed)
	measure 'Punch Closure Rate' = DIVIDE(CALCULATE(COUNTROWS(fct_QcPunch), fct_QcPunch[IsOpen] = FALSE()), [Total Punch Items])
		formatString: "0.0%"
		displayFolder: 02 Punch & completion

	/// Replaces Punch & RCL Log!N column (Days Open)
	measure 'Avg Days Punch Open' = AVERAGEX(FILTER(fct_QcPunch, fct_QcPunch[IsOpen] = TRUE()), fct_QcPunch[DaysOpen])
		formatString: "#,0.0"
		displayFolder: 02 Punch & completion

	/// Replaces Submittals & Mockups!B4 (Total)
	measure 'Total Submittals' = COUNTROWS(fct_QcSubmittal)
		formatString: "#,0"
		displayFolder: 03 Submittals & mock-ups

	/// Replaces Submittals & Mockups!I4 (Outstanding)
	measure 'Open Submittals' = CALCULATE(COUNTROWS(fct_QcSubmittal), fct_QcSubmittal[IsOpen] = TRUE())
		formatString: "#,0"
		displayFolder: 03 Submittals & mock-ups

	/// Replaces Submittals & Mockups - not computed in the workbook
	measure 'Overdue Submittals' = CALCULATE(COUNTROWS(fct_QcSubmittal), fct_QcSubmittal[IsOverdue] = TRUE())
		formatString: "#,0"
		displayFolder: 03 Submittals & mock-ups

	/// Replaces Submittals & Mockups - not computed in the workbook; closed submittals only
	measure 'Avg Submittal Turnaround Days' = AVERAGEX(FILTER(fct_QcSubmittal, NOT fct_QcSubmittal[IsOpen] && NOT ISBLANK(fct_QcSubmittal[TurnaroundDays])), fct_QcSubmittal[TurnaroundDays])
		formatString: "#,0.0"
		displayFolder: 03 Submittals & mock-ups

	/// Replaces Inferred from submittal subject text containing MOCK; may include false matches and miss unnamed mock-ups. Not a confirmed register.
	measure 'Possible Mock-Ups' = CALCULATE(COUNTROWS(fct_QcSubmittal), fct_QcSubmittal[IsMockup] = TRUE())
		formatString: "#,0"
		displayFolder: 03 Submittals & mock-ups

	/// Replaces Retrieved native Procore inspection records; month filters use inspection date. Not a certification of scope or completion.
	measure 'Native Inspections' = COUNTROWS(fct_ProcoreInspection)
		formatString: "#,0"
		displayFolder: 03 Submittals & mock-ups

	/// Replaces Retrieved native items linked through the project/inspection key; source responses are not reclassified.
	measure 'Native Inspection Items' = COUNTROWS(fct_ProcoreInspectionItem)
		formatString: "#,0"
		displayFolder: 03 Submittals & mock-ups

	/// Replaces Path to TCO!E4 + Path to Fire Alarm + Statutory Inspections
	measure 'Gates Defined' = COUNTROWS(qc_seed_Gate)
		formatString: "#,0"
		displayFolder: 04 Statutory gates

	/// Replaces Path to TCO!A9:A71
	measure 'Gates Recorded' = COUNTROWS(man_QcGate)
		formatString: "#,0"
		displayFolder: 04 Statutory gates

	/// Replaces Path to TCO!G4 (Complete)
	measure 'Gates Complete' = CALCULATE(COUNTROWS(man_QcGate), man_QcGate[StatusCode] = "COMPLETE")
		formatString: "#,0"
		displayFolder: 04 Statutory gates

	/// Replaces Recorded completion against the template for one project; applicability and readiness are not certified
	measure 'Gate Template Completion' =
			VAR Recorded = [Gates Recorded]
			VAR Completed = COALESCE([Gates Complete], 0)
			VAR Defined = [Gates Defined]
			RETURN IF(HASONEVALUE(dim_Project[ProjectKey]) && NOT ISBLANK(SELECTEDVALUE(dim_Project[ProjectKey])) && Recorded > 0 && Defined > 0 && Recorded <= Defined && Completed <= Recorded, DIVIDE(Completed, Defined))
		formatString: "0.0%"
		displayFolder: 04 Statutory gates

	/// Replaces DASHBOARD!D59 (TOTAL - ALL TRADE CHECKLISTS)
	measure 'Checklist Items Defined' = COUNTROWS(qc_seed_ChecklistItem)
		formatString: "#,0"
		displayFolder: 05 Trade checklists

	/// Replaces the 26 trade checklist tabs, column G
	measure 'Checklist Items Recorded' = COUNTROWS(man_QcChecklistResult)
		formatString: "#,0"
		displayFolder: 05 Trade checklists

	/// Replaces DASHBOARD!E59 (Pass)
	measure 'Checklist Items Passed' = CALCULATE(COUNTROWS(man_QcChecklistResult), man_QcChecklistResult[ResultCode] = "PASS")
		formatString: "#,0"
		displayFolder: 05 Trade checklists

	/// Replaces DASHBOARD!F59 (Fail)
	measure 'Checklist Items Failed' = CALCULATE(COUNTROWS(man_QcChecklistResult), man_QcChecklistResult[ResultCode] = "FAIL")
		formatString: "#,0"
		displayFolder: 05 Trade checklists

	/// Replaces Recorded passes against the template for one project; applicability and submission completeness are unverified
	measure 'Checklist Template Completion' =
			VAR Recorded = [Checklist Items Recorded]
			VAR Completed = COALESCE([Checklist Items Passed], 0)
			VAR Defined = [Checklist Items Defined]
			RETURN IF(HASONEVALUE(dim_Project[ProjectKey]) && NOT ISBLANK(SELECTEDVALUE(dim_Project[ProjectKey])) && Recorded > 0 && Defined > 0 && Recorded <= Defined && Completed <= Recorded, DIVIDE(Completed, Defined))
		formatString: "0.0%"
		displayFolder: 05 Trade checklists

	/// Replaces DFOW Risk Register!A5:A36
	measure 'DFOWs Registered' = COUNTROWS(man_QcDfow)
		formatString: "#,0"
		displayFolder: 06 DFOW, ITP & inspections

	/// Replaces DASHBOARD!B29 (Tier 3 & 4 DFOWs)
	measure 'Tier 3 And 4 DFOWs' = CALCULATE(COUNTROWS(man_QcDfow), man_QcDfow[RiskTier] >= 3)
		formatString: "#,0"
		displayFolder: 06 DFOW, ITP & inspections

	/// Replaces DASHBOARD!B10 (ITP total)
	measure 'ITP Tests Defined' = COUNTROWS(man_QcItp)
		formatString: "#,0"
		displayFolder: 06 DFOW, ITP & inspections

	/// Replaces DASHBOARD!C10 (ITP Pass)
	measure 'ITP Tests Passed' = CALCULATE(COUNTROWS(man_QcItp), man_QcItp[ResultCode] = "PASS")
		formatString: "#,0"
		displayFolder: 06 DFOW, ITP & inspections

	/// Replaces Special Inspections!B4 (Total Events)
	measure 'Special Inspections Logged' = COUNTROWS(man_QcSpecialInspection)
		formatString: "#,0"
		displayFolder: 06 DFOW, ITP & inspections

	/// Replaces DASHBOARD!B28 (Inspector sign-in entries)
	measure 'Inspector Visits Logged' = COUNTROWS(man_QcInspectorSignIn)
		formatString: "#,0"
		displayFolder: 06 DFOW, ITP & inspections

	/// Replaces DASHBOARD!C11 (Commissioning accepted)
	measure 'Systems Accepted' = CALCULATE(COUNTROWS(man_QcCommissioning), man_QcCommissioning[StatusCode] = "ACCEPTED")
		formatString: "#,0"
		displayFolder: 06 DFOW, ITP & inspections

	/// Replaces DOH Checklist!D4 (Verified)
	measure 'DOH Items Verified' = CALCULATE(COUNTROWS(man_QcDohResult), man_QcDohResult[StatusCode] = "VERIFIED")
		formatString: "#,0"
		displayFolder: 06 DFOW, ITP & inspections

	/// Replaces nothing - Excel drops unmatched rows from a lookup silently
	measure 'DQ Observations With Unmapped Trade' = CALCULATE(COUNTROWS(fct_QcNcr), fct_QcNcr[HasUnmappedTrade] = TRUE())
		formatString: "#,0"
		displayFolder: 07 Data quality

	/// Replaces nothing - Excel drops unmatched rows from a lookup silently
	measure 'DQ Punch With Unmapped Trade' = CALCULATE(COUNTROWS(fct_QcPunch), fct_QcPunch[HasUnmappedTrade] = TRUE())
		formatString: "#,0"
		displayFolder: 07 Data quality

	/// Replaces Observed row coverage in current filters; populated registers are not certified complete
	measure 'DQ Registers Awaiting Input' =
			VAR EmptyRegisters = IF(COUNTROWS(man_QcDfow) = 0, 1, 0) + IF(COUNTROWS(man_QcItp) = 0, 1, 0) + IF(COUNTROWS(man_QcGate) = 0, 1, 0) + IF(COUNTROWS(man_QcSpecialInspection) = 0, 1, 0) + IF(COUNTROWS(man_QcCommissioning) = 0, 1, 0) + IF(COUNTROWS(man_QcInspectorSignIn) = 0, 1, 0) + IF(COUNTROWS(man_QcChecklistResult) = 0, 1, 0) + IF(COUNTROWS(man_QcDohResult) = 0, 1, 0)
			RETURN FORMAT(EmptyRegisters, "0") & "/8 registers empty in current filters; completeness unverified"
		displayFolder: 07 Data quality

	/// Replaces nothing - rejects, unmapped trades, coverage and certificate gaps in one register
	measure 'Data Gaps' = COALESCE(COUNTROWS(dq_DataGap), 0)
		formatString: "#,0"
		displayFolder: 07 Data quality

	/// Replaces money carried by data gaps - today only unmatched AR invoices carry an amount
	measure 'Data Gap Amount' = SUM(dq_DataGap[Amount])
		formatString: "$#,0"
		displayFolder: 07 Data quality

	column _placeholder
		isHidden
		dataType: string
		summarizeBy: none
		sourceColumn: _placeholder

	column _built_at
		isHidden
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		summarizeBy: none
		sourceColumn: _built_at

	partition _Measures = entity
		mode: directLake
		source
			entityName: measures_anchor
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
