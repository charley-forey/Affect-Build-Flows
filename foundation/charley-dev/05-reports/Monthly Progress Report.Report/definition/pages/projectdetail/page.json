{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "projectdetail",
  "displayName": "Project Detail",
  "displayOption": "FitToPage",
  "height": 720,
  "width": 1280,
  "visibility": "HiddenInViewMode",
  "pageBinding": {
    "name": "projectdetail_binding",
    "type": "Drillthrough",
    "parameters": [
      {
        "name": "ProjectName"
      }
    ]
  },
  "filterConfig": {
    "filters": [
      {
        "name": "projectdetail_drill",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "dim_Project"
              }
            },
            "Property": "ProjectName"
          }
        },
        "type": "Passthrough"
      }
    ]
  }
}