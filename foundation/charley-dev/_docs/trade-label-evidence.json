 "query": "WITH raw AS (SELECT 'O' src, project_id, trade, CAST(created_date AS date) d FROM dbo.cd_silver_qc_ncr UNION ALL SELECT 'P', project_id, trade, CAST(created_date AS date) FROM dbo.cd_silver_qc_punch UNION ALL SELECT 'I', project_id, trade, CAST(inspection_date AS date) FROM dbo.cd_silver_qc_inspection) SELECT MIN(LTRIM(RTRIM(trade))) label, SUM(CASE WHEN src='O' THEN 1 ELSE 0 END) obs, SUM(CASE WHEN src='P' THEN 1 ELSE 0 END) punch, SUM(CASE WHEN src='I' THEN 1 ELSE 0 END) insp, COUNT(DISTINCT project_id) projects, MIN(d) first_seen, MAX(d) last_seen FROM raw WHERE NULLIF(LTRIM(RTRIM(trade)),'') IS NOT NULL GROUP BY UPPER(LTRIM(RTRIM(trade))) ORDER BY COUNT(*) DESC",
