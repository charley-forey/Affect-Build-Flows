		summarizeBy: none
		sourceColumn: MonthStart
		formatString: yyyy-mm-dd

	column HasOutOfRangeDate
		dataType: boolean
		summarizeBy: none
		sourceColumn: HasOutOfRangeDate

	column IsApproved
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsApproved

	partition fct_DirectCost = entity
		mode: directLake
		source
			entityName: fct_directcost
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
