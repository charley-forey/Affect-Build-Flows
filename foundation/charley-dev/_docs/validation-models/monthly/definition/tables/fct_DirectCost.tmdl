	column ProjectKey
		dataType: string
		summarizeBy: none
		sourceColumn: ProjectKey

	column VendorKey
		dataType: string
		summarizeBy: none
		sourceColumn: VendorKey

	column VendorName
		dataType: string
		summarizeBy: none
		sourceColumn: VendorName

	column Description
		dataType: string
		summarizeBy: none
		sourceColumn: Description

	column CostType
		dataType: string
		summarizeBy: none
		sourceColumn: CostType

	column CostCategory
		dataType: string
		summarizeBy: none
		sourceColumn: CostCategory

	column EmployeeName
		dataType: string
		summarizeBy: none
		sourceColumn: EmployeeName

	column StatusLabel
		dataType: string
		summarizeBy: none
		sourceColumn: StatusLabel

	column CostDate
		dataType: dateTime
		summarizeBy: none
		sourceColumn: CostDate
		formatString: yyyy-mm-dd

	column Amount
