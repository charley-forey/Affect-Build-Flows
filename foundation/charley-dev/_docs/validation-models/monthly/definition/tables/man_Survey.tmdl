table man_Survey

	column ProjectKey
		dataType: string
		summarizeBy: none
		sourceColumn: ProjectKey

	column MonthStart
		dataType: dateTime
		summarizeBy: none
		sourceColumn: MonthStart
		formatString: yyyy-mm-dd

	column QuestionNumber
		dataType: int64
		summarizeBy: sum
		sourceColumn: QuestionNumber

	column QuestionText
		dataType: string
		summarizeBy: none
		sourceColumn: QuestionText

	column Score
		dataType: int64
		summarizeBy: sum
		sourceColumn: Score

	column SurveyedParty
		dataType: string
		summarizeBy: none
		sourceColumn: SurveyedParty

	partition man_Survey = entity
		mode: directLake
		source
			entityName: man_survey
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
