table man_PriorityItems

	column ProjectKey
		dataType: string
		summarizeBy: none
		sourceColumn: ProjectKey

	column MonthStart
		dataType: dateTime
		summarizeBy: none
		sourceColumn: MonthStart
		formatString: yyyy-mm-dd

	column ItemNumber
		dataType: int64
		summarizeBy: sum
		sourceColumn: ItemNumber

	column ScheduleItem
		dataType: string
		summarizeBy: none
		sourceColumn: ScheduleItem

	column StatusCode
		dataType: string
		summarizeBy: none
		sourceColumn: StatusCode

	column CriticalDelays
		dataType: string
		summarizeBy: none
		sourceColumn: CriticalDelays

	column RecoveryPlan
		dataType: string
		summarizeBy: none
		sourceColumn: RecoveryPlan

	column ForecastImpact
		dataType: string
		summarizeBy: none
		sourceColumn: ForecastImpact

	column Notes
		dataType: string
		summarizeBy: none
		sourceColumn: Notes

	partition man_PriorityItems = entity
		mode: directLake
		source
			entityName: man_priorityitems
			schemaName: dbo
			expressionSource: 'DirectLake - CD_Gold_Lakehouse'
