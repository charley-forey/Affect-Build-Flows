table fct_RfiSubmittal

	lineageTag: 8a1c0001-0000-4000-8000-000000000001

	measure 'Open Critical RFIs' =
			CALCULATE (
			    COUNTROWS ( fct_RfiSubmittal ),
			    fct_RfiSubmittal[ItemType] = "RFI",
			    fct_RfiSubmittal[IsCritical] = TRUE (),
			    FILTER ( ALL ( dim_Status ), dim_Status[Code] = "OPEN" )
			)
		formatString: 0
		lineageTag: 8a1c0001-0000-4000-8000-000000000a01

	measure 'Open Critical Submittals' =
			CALCULATE (
			    COUNTROWS ( fct_RfiSubmittal ),
			    fct_RfiSubmittal[ItemType] = "Submittal",
			    fct_RfiSubmittal[IsCritical] = TRUE (),
			    FILTER ( ALL ( dim_Status ), dim_Status[Code] = "OPEN" )
			)
		formatString: 0
		lineageTag: 8a1c0001-0000-4000-8000-000000000a02

	measure 'Avg RFI Days Open' =
			CALCULATE (
			    AVERAGE ( fct_RfiSubmittal[DaysOpen] ),
			    fct_RfiSubmittal[ItemType] = "RFI"
			)
		formatString: 0.0
		lineageTag: 8a1c0001-0000-4000-8000-000000000a03

	column ProjectKey
		dataType: int64
		formatString: 0
