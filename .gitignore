# Internal working notes (never share with client)
internal/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Secrets / local env
.env
.env.*
*.pem
*.key
credentials.json

# Temp
*.tmp
*.log
~$*

# Large regenerable vendor artifacts (52MB — over GitHub's 50MB warning threshold).
# Re-download instructions in resources/procore/README.md; the committed
# endpoints-cheatsheet.md is generated from it.
resources/**/combined_OAS.json

# Local pipeline output (regenerated by src/procore/run_local.py)
.local/

# Python
__pycache__/
*.pyc

# Claude Code local state (contains a full git worktree — never commit)
.claude/

# LibreOffice lock files
.~lock.*#

# charley-dev evidence: raw source payloads, driver logs and large dumps carry client PII
# (people's emails, names) and this repo is PUBLIC. Keep locally; commit summaries/hashes only.
foundation/charley-dev/_docs/**/*.jsonl
foundation/charley-dev/_docs/**/*-stdout.txt
foundation/charley-dev/_docs/**/*-error-tail.txt
foundation/charley-dev/_docs/inspection-silver-live.json
foundation/charley-dev/_docs/budget-bronze-evidence.json
foundation/charley-dev/_docs/budget-grain-evidence.json
foundation/charley-dev/_docs/candidate-monthly-dax-evidence.json
foundation/charley-dev/_docs/candidate-qc-dax-evidence.json
foundation/charley-dev/_docs/procore-repair-spark-jobs.json
